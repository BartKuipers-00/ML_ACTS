#!/usr/bin/env condor_submit
# Evaluate multiplicity sweep: build graphs + GNN inference + track building
# for particles_per_vertex = 10,20,...,130
# Process 0 → ppv=10, Process 1 → ppv=20, ..., Process 12 → ppv=130
# 13 jobs total, each fully independent

executable              = run_multiplicity_sweep_eval.sh
log                     = /data/alice/bkuipers/jobs/output/multiplicity_sweep_eval_$(ClusterId).log
output                  = /data/alice/bkuipers/jobs/output/multiplicity_sweep_eval_$(ClusterId).$(Process).out
error                   = /data/alice/bkuipers/jobs/output/multiplicity_sweep_eval_$(ClusterId).$(Process).err

arguments               = $(Process)

+UseOS                  = "el9"
+JobCategory            = "medium"

# GPU needed for GNN inference
request_gpus            = 1
request_cpus            = 8
request_memory          = 16G
requirements            = regexp("L40S", TARGET.GPUs_DeviceName)

should_transfer_files   = NO
initialdir              = /data/alice/bkuipers/out_of_distribution_experiment

environment             = "CONDA_ENV=acorn"

# n_jobs passed by submit_sweep.sh: Process 0..n_jobs-1 → ppv 10,20,...,max_particles_per_vertex
queue $(n_jobs)
