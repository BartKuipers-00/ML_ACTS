#!/usr/bin/env condor_submit
# Multiplicity sweep: simulate + clean + convert for particles_per_vertex = 10,20,...,130
# Process 0 → ppv=10, Process 1 → ppv=20, ..., Process 12 → ppv=130
# 13 jobs total, each fully independent

executable              = run_multiplicity_sweep_job.sh
log                     = /data/alice/bkuipers/jobs/output/multiplicity_sweep_$(ClusterId).log
output                  = /data/alice/bkuipers/jobs/output/multiplicity_sweep_$(ClusterId).$(Process).out
error                   = /data/alice/bkuipers/jobs/output/multiplicity_sweep_$(ClusterId).$(Process).err

# Pass HTCondor Process index to shell script
arguments               = $(Process)

# Use Alma Linux 9 environment
+UseOS                  = "el9"

# Short jobs - simulation + CPU processing
+JobCategory            = "short"

# Resource requirements per job
# ACTS simulation uses multi-threading; set to 4 CPUs for safe parallelism
request_cpus            = 4
request_memory          = 8G

# File transfer settings
should_transfer_files   = NO
initialdir              = /data/alice/bkuipers/low_pt_gnn_pipeline

# Environment
environment             = "CONDA_ENV=acorn"

# n_jobs passed by submit_sweep.sh: Process 0..n_jobs-1 → ppv 10,20,...,max_particles_per_vertex
queue $(n_jobs)
