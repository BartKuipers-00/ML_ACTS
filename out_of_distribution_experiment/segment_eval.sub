#!/usr/bin/env condor_submit
# Track building + evaluation for every data_* directory in the experiment dir.
# One job per directory; HTCondor discovers them automatically via queue matching.
#
# Usage:
#   condor_submit segment_eval.sub

executable              = run_segment_eval_job.sh
arguments               = $(DataDir)

log                     = /data/alice/bkuipers/jobs/output/segment_eval_$(ClusterId).log
output                  = /data/alice/bkuipers/jobs/output/segment_eval_$(ClusterId)_$(DataDir).out
error                   = /data/alice/bkuipers/jobs/output/segment_eval_$(ClusterId)_$(DataDir).err

+UseOS                  = "el9"
+JobCategory            = "medium"

# No GPU needed — helix fitting is CPU-only.
# Set request_gpus = 1 and uncomment requirements if use_segment_gnn: true.
request_cpus            = 4
request_memory          = 8G
# request_gpus          = 1
# requirements          = regexp("L40S", TARGET.GPUs_DeviceName)

should_transfer_files   = NO
initialdir              = /data/alice/bkuipers/out_of_distribution_experiment

environment             = "CONDA_ENV=acorn"

queue DataDir from data_dirs.txt
