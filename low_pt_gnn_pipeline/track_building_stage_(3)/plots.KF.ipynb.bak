   "source": [
    "# ── KF stop-layer / outermost-reached distribution per pT bin ───────────────\n",
    "# Two views available via STOP_KEY:\n",
    "#   \"stop_count\"          — last-in-time barrel hit (looping tracks pile up at\n",
    "#                           the innermost layer, since they return there last)\n",
    "#   \"stop_count_matched\"  — same, restricted to trackClassification==Matched\n",
    "#   \"outer_count\"         — outermost barrel layer the trajectory ever\n",
    "#                           reached (= apex of the helix). For low-pT looping\n",
    "#                           tracks this matches the helix radius / pT.\n",
    "#   \"outer_count_matched\" — same, ghost-filtered\n",
    "LAYER_NAMES = [\"V13L4\", \"V13L6\", \"V13L8\", \"V17L2\", \"V17L4\"]\n",
    "LAYER_COLORS = {\"V13L4\": \"C0\", \"V13L6\": \"C1\", \"V13L8\": \"C2\",\n",
    "                \"V17L2\": \"C4\", \"V17L4\": \"C3\"}\n",
    "\n",
    "# Toggle between the four available views.\n",
    "STOP_KEY = \"outer_count\"   # was \"stop_count\" — switch as needed\n",
    "\n",
    "DEN_KEY = \"n_total_matched\" if STOP_KEY.endswith(\"_matched\") else \"n_total\"\n",
    "stop_total = np.array(kf[DEN_KEY], dtype=float)\n",
    "stop_centers = kf_centers\n",
    "half_w = 0.5 * (stop_centers[1] - stop_centers[0])\n",
    "\n",
    "VIEW_LABEL = {\n",
    "    \"stop_count\":          \"last-in-time hit\",\n",
    "    \"stop_count_matched\":  \"last-in-time hit  (Matched only)\",\n",
    "    \"outer_count\":         \"outermost layer reached\",\n",
    "    \"outer_count_matched\": \"outermost layer reached  (Matched only)\",\n",
    "}[STOP_KEY]\n",
    "\n",
    "# ── all layers on one axis ──\n",
    "fig, ax = plt.subplots(figsize=FIGSIZE)\n",
    "ymax_all = 0.0\n",
    "for name in LAYER_NAMES:\n",
    "    cnt = np.array(kf[STOP_KEY][name], dtype=float)\n",
    "    with np.errstate(divide=\"ignore\", invalid=\"ignore\"):\n",
    "        f   = np.where(stop_total > 0, cnt / stop_total, np.nan)\n",
    "        err = np.where(\n",
    "            stop_total > 0,\n",
    "            np.sqrt(np.maximum(0, f * (1 - f)) /\n",
    "                    np.where(stop_total > 0, stop_total, 1)),\n",
    "            np.nan,\n",
    "        )\n",
    "    if np.any(f > 0):\n",
    "        ymax_all = max(ymax_all, np.nanmax(f))\n",
    "    ax.errorbar(stop_centers, f, yerr=err, xerr=half_w,\n",
    "                fmt=\"o-\", color=LAYER_COLORS[name], markersize=3,\n",
    "                linewidth=1.5, capsize=2, label=name)\n",
    "overlay_dips(ax)\n",
    "for lay, thr in dip_layers:\n",
    "    ax.axvline(thr, color=\"grey\", linestyle=\":\", linewidth=1.0, alpha=0.4)\n",
    "ax.axvline(LOOP_PT, color=\"red\", linestyle=\"-.\", linewidth=1.2, alpha=0.6,\n",
    "           label=f\"V17L4 loop thr ≈ {LOOP_PT:.3f}\")\n",
    "ax.set_xlabel(r\"$p_T$ [GeV]\", fontsize=FONT_AXIS)\n",
    "ax.set_ylabel(f\"Fraction of CKF attempts ({VIEW_LABEL})\", fontsize=FONT_AXIS)\n",
    "ax.set_title(f\"KF {VIEW_LABEL} vs pT  \"\n",
    "             f\"(MAX_EVENTS={kf['max_events']})\", fontsize=11)\n",
    "ax.tick_params(labelsize=FONT_TICK)\n",
    "ax.legend(fontsize=FONT_LEGEND, loc=\"upper right\", ncol=2)\n",
    "ax.grid(True, alpha=GRID_ALPHA)\n",
    "ax.set_xlim(stop_centers[0], stop_centers[-1])\n",
    "ax.set_ylim(0, max(0.05, ymax_all * 1.15))\n",
    "fig.tight_layout()\n",
    "out = KF_JSON.parent / f\"kf_{STOP_KEY}_combined.pdf\"\n",
    "fig.savefig(out, bbox_inches=\"tight\", dpi=DPI)\n",
    "print(f\"Saved: {out}\")\n",
    "plt.show()\n",
    "\n",
    "# ── one plot per layer (zoomed y-axis per panel) ──\n",
    "for name in LAYER_NAMES:\n",
    "    cnt = np.array(kf[STOP_KEY][name], dtype=float)\n",
    "    with np.errstate(divide=\"ignore\", invalid=\"ignore\"):\n",
    "        f   = np.where(stop_total > 0, cnt / stop_total, np.nan)\n",
    "        err = np.where(\n",
    "            stop_total > 0,\n",
    "            np.sqrt(np.maximum(0, f * (1 - f)) /\n",
    "                    np.where(stop_total > 0, stop_total, 1)),\n",
    "            np.nan,\n",
    "        )\n",
    "    fig, ax = plt.subplots(figsize=FIGSIZE)\n",
    "    ax.errorbar(stop_centers, f, yerr=err, xerr=half_w,\n",
    "                fmt=\"o-\", color=LAYER_COLORS[name], markersize=3,\n",
    "                linewidth=1.5, capsize=2, label=name)\n",
    "    overlay_dips(ax)\n",
    "    ymax = max(0.02, np.nanmax(f) * 1.3) if np.any(f > 0) else 0.05\n",
    "    for lay, thr in dip_layers:\n",
    "        ax.axvline(thr, color=\"grey\", linestyle=\":\", linewidth=1.0, alpha=0.4)\n",
    "        ax.text(thr, ymax * 0.97, lay, rotation=90, fontsize=9,\n",
    "                color=\"dimgrey\", ha=\"right\", va=\"top\")\n",
    "    ax.axvline(LOOP_PT, color=\"red\", linestyle=\"-.\", linewidth=1.2, alpha=0.6,\n",
    "               label=f\"V17L4 loop thr ≈ {LOOP_PT:.3f}\")\n",
    "    ax.set_xlabel(r\"$p_T$ [GeV]\", fontsize=FONT_AXIS)\n",
    "    ax.set_ylabel(f\"P({VIEW_LABEL} = {name})\", fontsize=FONT_AXIS)\n",
    "    ax.set_title(f\"KF {VIEW_LABEL} = {name}\", fontsize=12)\n",
    "    ax.tick_params(labelsize=FONT_TICK)\n",
    "    ax.legend(fontsize=FONT_LEGEND, loc=\"upper right\")\n",
    "    ax.grid(True, alpha=GRID_ALPHA)\n",
    "    ax.set_xlim(stop_centers[0], stop_centers[-1])\n",
    "    ax.set_ylim(0, ymax)\n",
    "    fig.tight_layout()\n",
    "    out = KF_JSON.parent / f\"kf_{STOP_KEY}_{name}.pdf\"\n",
    "    fig.savefig(out, bbox_inches=\"tight\", dpi=DPI)\n",
    "    print(f\"Saved: {out}\")\n",
    "    plt.show()\n"
   ]
  },
