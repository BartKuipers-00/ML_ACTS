   ],
   "source": [
    "# ── Outgoing-only at CKF level, split by trackClassification ────────────────\n",
    "# All-classes (red) includes Matched + Duplicate + Unknown + Fake. The\n",
    "# Matched-only (orange) curve drops Duplicate/Unknown ghost branches, leaving\n",
    "# the unique winning track per particle. If the two curves overlap, the\n",
    "# failure signature is intrinsic to propagator behaviour, not ghost branching.\n",
    "# Source: outgoing_only_kf.C\n",
    "KF_JSON = DATA_DIR / \"outgoing_only_kf.json\"\n",
    "with open(KF_JSON) as f:\n",
    "    kf = json.load(f)\n",
    "\n",
    "kf_centers = np.array(kf[\"pt_centers\"])\n",
    "\n",
    "def _frac_with_err(num, den):\n",
    "    num = np.asarray(num, dtype=float)\n",
    "    den = np.asarray(den, dtype=float)\n",
    "    with np.errstate(divide=\"ignore\", invalid=\"ignore\"):\n",
    "        f   = np.where(den > 0, num / den, np.nan)\n",
    "        err = np.where(\n",
    "            den > 0,\n",
    "            np.sqrt(np.maximum(0, f * (1 - f)) /\n",
    "                    np.where(den > 0, den, 1)),\n",
    "            np.nan,\n",
    "        )\n",
    "    return f, err\n",
    "\n",
    "f_all, err_all       = _frac_with_err(kf[\"n_outgoing_only_short\"],\n",
    "                                       kf[\"n_total\"])\n",
    "f_match, err_match   = _frac_with_err(kf[\"n_outgoing_only_short_matched\"],\n",
    "                                       kf[\"n_total_matched\"])\n",
    "f_anyR, _            = _frac_with_err(kf[\"n_outgoing_only\"],\n",
    "                                       kf[\"n_total\"])\n",
    "\n",
    "# ── Three curves together: all-class short, Matched-only short, all-class any ──\n",
    "fig, ax = plt.subplots(figsize=FIGSIZE)\n",
    "ax.errorbar(kf_centers, f_all, yerr=err_all,\n",
    "            fmt=\"o-\", color=\"C3\", markersize=4, linewidth=1.5, capsize=2,\n",
    "            label=r\"all classes: outgoing-only $\\wedge$ $r_{\\max}<1000$ mm\")\n",
    "ax.errorbar(kf_centers, f_match, yerr=err_match,\n",
    "            fmt=\"^-\", color=\"C1\", markersize=4, linewidth=1.5, capsize=2,\n",
    "            label=r\"Matched only: outgoing-only $\\wedge$ $r_{\\max}<1000$ mm\")\n",
    "overlay_dips(ax)\n",
    "ymax_top = np.nanmax(np.concatenate([f_all, f_match]))\n",
    "ymax = max(0.05, ymax_top * 1.3) if ymax_top > 0 else 0.1\n",
    "for lay, thr in dip_layers:\n",
    "    ax.axvline(thr, color=\"grey\", linestyle=\":\", linewidth=1.0, alpha=0.5)\n",
    "    ax.text(thr, ymax * 0.97, lay, rotation=90,\n",
    "            fontsize=9, color=\"dimgrey\", ha=\"right\", va=\"top\")\n",
    "ax.axvline(LOOP_PT, color=\"red\", linestyle=\"-.\", linewidth=1.2, alpha=0.6,\n",
    "           label=f\"V17L4 loop thr ≈ {LOOP_PT:.3f}\")\n",
    "ax.set_xlabel(r\"$p_T$ [GeV]\", fontsize=FONT_AXIS)\n",
    "ax.set_ylabel(r\"P(outgoing-only $\\wedge$ short)  [CKF]\", fontsize=FONT_AXIS)\n",
    "ax.set_title(f\"CKF failure signature: all classes vs Matched only \"\n",
    "             f\"(ghost-filtered)  (MAX_EVENTS={kf['max_events']})\",\n",
    "             fontsize=11)\n",
    "ax.tick_params(labelsize=FONT_TICK)\n",
    "ax.legend(fontsize=FONT_LEGEND, loc=\"upper right\")\n",
    "ax.grid(True, alpha=GRID_ALPHA)\n",
    "ax.set_xlim(kf_centers[0], kf_centers[-1])\n",
    "ax.set_ylim(0, ymax)\n",
    "fig.tight_layout()\n",
    "out = KF_JSON.parent / \"outgoing_only_kf_classes_replot.pdf\"\n",
    "fig.savefig(out, bbox_inches=\"tight\", dpi=DPI)\n",
    "print(f\"Saved: {out}\")\n",
    "plt.show()\n",
    "\n",
    "# ── GT vs CKF (Matched-only) comparison ──\n",
    "fig, ax = plt.subplots(figsize=FIGSIZE)\n",
    "ax.plot(oo_centers, f_short, \"o-\", color=\"C0\", markersize=4, linewidth=1.5,\n",
    "        label=r\"GT (Fatras truth hits)\")\n",
    "ax.errorbar(kf_centers, f_match, yerr=err_match,\n",
    "            fmt=\"s-\", color=\"C1\", markersize=4, linewidth=1.5, capsize=2,\n",
    "            label=r\"CKF Matched only (ghost-free)\")\n",
    "overlay_dips(ax)\n",
    "y_top = max(np.nanmax(f_short) if np.any(f_short > 0) else 0,\n",
    "            np.nanmax(f_match) if np.any(f_match > 0) else 0) * 1.2\n",
    "y_top = max(y_top, 0.05)\n",
    "for lay, thr in dip_layers:\n",
    "    ax.axvline(thr, color=\"grey\", linestyle=\":\", linewidth=1.0, alpha=0.5)\n",
    "    ax.text(thr, y_top * 0.97, lay, rotation=90,\n",
    "            fontsize=9, color=\"dimgrey\", ha=\"right\", va=\"top\")\n",
    "ax.axvline(LOOP_PT, color=\"red\", linestyle=\"-.\", linewidth=1.2, alpha=0.6,\n",
    "           label=f\"V17L4 loop thr ≈ {LOOP_PT:.3f}\")\n",
    "ax.set_xlabel(r\"$p_T$ [GeV]\", fontsize=FONT_AXIS)\n",
    "ax.set_ylabel(r\"P(outgoing-only $\\wedge$ $r_{\\max}<1000$ mm)\", fontsize=FONT_AXIS)\n",
    "ax.set_title(\"Failure signature: GT (Fatras) vs CKF (ghost-filtered)\",\n",
    "             fontsize=12)\n",
    "ax.tick_params(labelsize=FONT_TICK)\n",
    "ax.legend(fontsize=FONT_LEGEND, loc=\"upper right\")\n",
    "ax.grid(True, alpha=GRID_ALPHA)\n",
    "ax.set_xlim(oo_centers[0], oo_centers[-1])\n",
    "ax.set_ylim(0, y_top)\n",
    "fig.tight_layout()\n",
    "out = KF_JSON.parent / \"outgoing_only_gt_vs_ckf_matched_replot.pdf\"\n",
    "fig.savefig(out, bbox_inches=\"tight\", dpi=DPI)\n",
    "print(f\"Saved: {out}\")\n",
    "plt.show()\n"
   ]
  },
