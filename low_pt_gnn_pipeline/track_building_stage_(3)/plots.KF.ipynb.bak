   ],
   "source": [
    "# ── Outgoing-only muons: Fatras truth hits monotonically increasing in r ────\n",
    "# The \"short\" subset (r_max < 1000 mm, never reached outermost barrel layer)\n",
    "# is the propagator-failure signature: Fatras stopped mid-track without ever\n",
    "# starting the inward loop. If the red curve spikes at the layer thresholds\n",
    "# (dip_layers), there's a residual nearLimit-style oversight in the\n",
    "# propagator/navigator on top of the one already fixed.\n",
    "# Source: outgoing_only_muons.C\n",
    "OO_JSON = DATA_DIR / \"outgoing_only_muons.json\"\n",
    "with open(OO_JSON) as f:\n",
    "    oo = json.load(f)\n",
    "\n",
    "oo_centers = np.array(oo[\"pt_centers\"])\n",
    "oo_total   = np.array(oo[\"n_total\"], dtype=float)\n",
    "oo_any     = np.array(oo[\"n_outgoing_only\"], dtype=float)\n",
    "oo_short   = np.array(oo[\"n_outgoing_only_short\"], dtype=float)\n",
    "with np.errstate(divide=\"ignore\", invalid=\"ignore\"):\n",
    "    f_any   = np.where(oo_total > 0, oo_any   / oo_total, np.nan)\n",
    "    f_short = np.where(oo_total > 0, oo_short / oo_total, np.nan)\n",
    "    err_short = np.where(\n",
    "        oo_total > 0,\n",
    "        np.sqrt(np.maximum(0, f_short * (1 - f_short)) /\n",
    "                np.where(oo_total > 0, oo_total, 1)),\n",
    "        np.nan,\n",
    "    )\n",
    "\n",
    "# ── full plot: both curves with layer-threshold overlays ──\n",
    "fig, ax = plt.subplots(figsize=FIGSIZE)\n",
    "ax.plot(oo_centers, f_any, \"-\", color=\"C0\", linewidth=2, alpha=0.7,\n",
    "        label=r\"outgoing-only (any $r_{\\max}$)\")\n",
    "ax.errorbar(oo_centers, f_short, yerr=err_short,\n",
    "            fmt=\"o-\", color=\"C3\", markersize=4, linewidth=1.5, capsize=2,\n",
    "            label=r\"outgoing-only $\\wedge$ $r_{\\max}<1000$ mm  (failure sig.)\")\n",
    "overlay_dips(ax)\n",
    "for lay, thr in dip_layers:\n",
    "    ax.axvline(thr, color=\"grey\", linestyle=\":\", linewidth=1.0, alpha=0.5)\n",
    "ax.axvline(LOOP_PT, color=\"red\", linestyle=\"-.\", linewidth=1.2, alpha=0.6,\n",
    "           label=f\"V17L4 loop thr ≈ {LOOP_PT:.3f}\")\n",
    "ax.set_xlabel(r\"$p_T$ [GeV]\", fontsize=FONT_AXIS)\n",
    "ax.set_ylabel(\"Fraction of muon GT\", fontsize=FONT_AXIS)\n",
    "ax.set_title(f\"Outgoing-only muons per pT bin  (MAX_EVENTS={oo['max_events']})\",\n",
    "             fontsize=12)\n",
    "ax.tick_params(labelsize=FONT_TICK)\n",
    "ax.legend(fontsize=FONT_LEGEND, loc=\"upper right\")\n",
    "ax.grid(True, alpha=GRID_ALPHA)\n",
    "ax.set_xlim(oo_centers[0], oo_centers[-1])\n",
    "ax.set_ylim(0, max(0.05, np.nanmax(f_any) * 1.15))\n",
    "fig.tight_layout()\n",
    "out = OO_JSON.parent / \"outgoing_only_muons_replot.pdf\"\n",
    "fig.savefig(out, bbox_inches=\"tight\", dpi=DPI)\n",
    "print(f\"Saved: {out}\")\n",
    "plt.show()\n",
    "\n",
    "# ── zoomed: only the failure-signature curve, with layer labels ──\n",
    "fig, ax = plt.subplots(figsize=FIGSIZE)\n",
    "ax.errorbar(oo_centers, f_short, yerr=err_short,\n",
    "            fmt=\"o-\", color=\"C3\", markersize=4, linewidth=1.5, capsize=2,\n",
    "            label=r\"outgoing-only $\\wedge$ $r_{\\max}<1000$ mm\")\n",
    "overlay_dips(ax)\n",
    "ymax = max(0.02, np.nanmax(f_short) * 1.4) if np.any(f_short > 0) else 0.05\n",
    "for lay, thr in dip_layers:\n",
    "    ax.axvline(thr, color=\"grey\", linestyle=\":\", linewidth=1.0, alpha=0.5)\n",
    "    ax.text(thr, ymax * 0.97, lay, rotation=90,\n",
    "            fontsize=9, color=\"dimgrey\", ha=\"right\", va=\"top\")\n",
    "ax.axvline(LOOP_PT, color=\"red\", linestyle=\"-.\", linewidth=1.2, alpha=0.6,\n",
    "           label=f\"V17L4 loop thr ≈ {LOOP_PT:.3f}\")\n",
    "ax.set_xlabel(r\"$p_T$ [GeV]\", fontsize=FONT_AXIS)\n",
    "ax.set_ylabel(r\"P(outgoing-only $\\wedge$ short)\", fontsize=FONT_AXIS)\n",
    "ax.set_title(f\"Failure-signature fraction vs pT  (MAX_EVENTS={oo['max_events']})\",\n",
    "             fontsize=12)\n",
    "ax.tick_params(labelsize=FONT_TICK)\n",
    "ax.legend(fontsize=FONT_LEGEND, loc=\"upper right\")\n",
    "ax.grid(True, alpha=GRID_ALPHA)\n",
    "ax.set_xlim(oo_centers[0], oo_centers[-1])\n",
    "ax.set_ylim(0, ymax)\n",
    "fig.tight_layout()\n",
    "out = OO_JSON.parent / \"outgoing_only_muons_short_zoom_replot.pdf\"\n",
    "fig.savefig(out, bbox_inches=\"tight\", dpi=DPI)\n",
    "print(f\"Saved: {out}\")\n",
    "plt.show()\n"
   ]
  },
