    "\n",
    "fig, axes = plt.subplots(1, 2, figsize=(2 * FIGSIZE[0], FIGSIZE[1]),\n",
    "                         sharey=True)\n",
    "for ax_p, species in zip(axes, [\"Electron\", \"Pion\"]):\n",
    "    palette = PARTICLE_COLOR_P1[species]\n",
    "    color_seed = palette[\"dark\"]\n",
    "    color_ckf  = palette[\"main\"]\n",
    "    color_gnn  = palette[\"light\"]\n",
    "\n",
