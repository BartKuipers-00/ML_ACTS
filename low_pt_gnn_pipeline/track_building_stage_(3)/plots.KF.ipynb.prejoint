   "source": [
    "# ── Fake rate vs pT: Triplet seeding vs Triplet seeding + CKF ─────────────\n",
    "# Species-AVERAGED fake-rate companion to the overall-efficiency plot\n",
    "# (cell 25). \"Species-averaged\" = unweighted mean of the four per-species\n",
    "# fake rates (each species equal weight, NOT track-count weighted), exactly\n",
    "# as _macro_avg does for the efficiency. Both stages use the per-species\n",
    "# counts binned by the MAJORITY-TRUTH particle pT and rebinned to the GNN\n",
    "# grid, so the binning matches the efficiency plot bin-for-bin.\n",
    "#   Seeding: seeding_fake_rate_per_pt.json  n_*_truth_species\n",
    "#   CKF:     fake_rate_per_pt.json          n_*_truth_species\n",
    "# Fake = no truth particle matches (seed: <100% purity; CKF: two-way 0.7).\n",
    "# Uncertainty: Clopper-Pearson 68% per species, combined in quadrature / N.\n",
    "\n",
    "with open(DATA_DIR / \"seeding_fake_rate_per_pt.json\") as _f:\n",
    "    _sfr = json.load(_f)\n",
    "with open(DATA_DIR / \"fake_rate_per_pt.json\") as _f:\n",
    "    _fr = json.load(_f)\n",
    "\n",
    "_all_species = [\"Electron\", \"Muon\", \"Pion\", \"Proton\"]\n",
    "\n",
    "def _macro_fake(data):\n",
    "    \"\"\"Unweighted species-mean fake rate on the GNN grid: (fr, lo, hi, mask).\"\"\"\n",
    "    src = np.array(data[\"pt_centers\"], float)\n",
    "    fr_st, lo_st, hi_st = [], [], []\n",
    "    for sp in _all_species:\n",
    "        n, d = _rebin_to_gnn(np.array(data[\"n_fake_truth_species\"][sp],  float),\n",
    "                             np.array(data[\"n_total_truth_species\"][sp], float),\n",
    "                             src)\n",
    "        valid = d > 0\n",
    "        fr = np.where(valid, n / np.where(valid, d, 1), np.nan)\n",
    "        lo, hi = _kf_cp_err(n, d)\n",
    "        fr_st.append(fr)\n",
    "        lo_st.append(np.where(valid, lo, np.nan))\n",
    "        hi_st.append(np.where(valid, hi, np.nan))\n",
    "    fr_st = np.vstack(fr_st); lo_st = np.vstack(lo_st); hi_st = np.vstack(hi_st)\n",
    "    with np.errstate(invalid=\"ignore\"):\n",
    "        fr_m  = np.nanmean(fr_st, axis=0)\n",
    "        n_val = np.sum(np.isfinite(fr_st), axis=0)\n",
    "        lo_m  = np.sqrt(np.nansum(lo_st**2, axis=0)) / np.where(n_val > 0, n_val, 1)\n",
    "        hi_m  = np.sqrt(np.nansum(hi_st**2, axis=0)) / np.where(n_val > 0, n_val, 1)\n",
    "    mask = n_val == len(_all_species)\n",
    "    return fr_m, lo_m, hi_m, mask\n",
    "\n",
    "fig, ax_p = plt.subplots(figsize=FIGSIZE)\n",
    "\n",
    "# Triplet seeding\n",
    "fr_m, lo_m, hi_m, mask = _macro_fake(_sfr)\n",
    "ax_p.errorbar(gnn_x[mask], fr_m[mask],\n",
    "              xerr=gnn_xerr[mask], yerr=[lo_m[mask], hi_m[mask]],\n",
    "              fmt=METHOD_MARKER_P1[\"seed\"], color=\"#1f3a68\",\n",
    "              markersize=MS_P1, capsize=CAPSIZE, capthick=1,\n",
    "              label=\"Triplet seeding\")\n",
    "\n",
    "# Triplet seeding + CKF\n",
    "fr_m, lo_m, hi_m, mask = _macro_fake(_fr)\n",
    "ax_p.errorbar(gnn_x[mask], fr_m[mask],\n",
    "              xerr=gnn_xerr[mask], yerr=[lo_m[mask], hi_m[mask]],\n",
    "              fmt=METHOD_MARKER_P1[\"ckf\"], color=\"#c0392b\",\n",
    "              markersize=MS_P1, capsize=CAPSIZE, capthick=1,\n",
    "              label=\"Triplet seeding + CKF\")\n",
    "\n",
    "ax_p.set_xlabel(r\"$p_T$ [GeV]\", fontsize=FONT_AXIS)\n",
    "ax_p.set_ylabel(\"Fake rate\", fontsize=FONT_AXIS)\n",
    "ax_p.set_xlim(0.0, 0.55)\n",
    "ax_p.set_xticks(np.arange(0.1, 0.51, 0.1))\n",
    "ax_p.set_xticks(np.arange(0.05, 0.51, 0.1), minor=True)\n",
    "ax_p.set_ylim(0.0, 1.05)\n",
    "ax_p.tick_params(labelsize=FONT_TICK - 1)\n",
    "ax_p.grid(True, which=\"both\", alpha=GRID_ALPHA)\n",
    "ax_p.legend(fontsize=FONT_LEGEND - 1, loc=\"upper right\", frameon=False)\n",
    "\n",
    "# Annotation block: lower-left (empty there — both curves are high at low pT).\n",
    "ANNO_ANCHOR = (0.04, 0.30)\n",
    "_anno_box = dict(facecolor=\"white\", edgecolor=\"none\", alpha=0.85, pad=2)\n",
    "_ax, _ay = ANNO_ANCHOR\n",
    "_anno_kw = dict(transform=ax_p.transAxes, va=\"top\", ha=\"left\", bbox=_anno_box)\n",
    "ax_p.text(_ax, _ay,                    r\"$\\mathbf{Generic \\ Detector}$ Simulation\",\n",
    "          fontsize=FONT_AXIS - 3, **_anno_kw)\n",
    "ax_p.text(_ax, _ay -  ANNO_LINE_DY,    \"FATRAS, 300 particles / event\",\n",
    "          fontsize=FONT_AXIS - 5, style=\"italic\", **_anno_kw)\n",
    "ax_p.text(_ax, _ay - 2 * ANNO_LINE_DY, r\"$|\\eta| < 0.15$, species-averaged\",\n",
    "          fontsize=FONT_AXIS - 5, style=\"italic\", **_anno_kw)\n",
    "\n",
    "fig.tight_layout()\n",
    "out = DATA_DIR / \"fake_rate_seeding_ckf_overall_replot.pdf\"\n",
    "fig.savefig(out, bbox_inches=\"tight\", dpi=DPI)\n",
    "print(f\"Saved: {out}\")\n",
    "plt.show()\n"
   ]
  },
