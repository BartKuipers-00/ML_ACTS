    "ax.set_title(f\"{species}: # GT particles that reach each layer\\n(ALL GT, >=1 truth hit)\",\n",
    "             fontsize=12)\n",
    "ax.tick_params(labelsize=FONT_TICK)\n",
    "ax.legend(fontsize=FONT_LEGEND, ncol=1, loc=\"upper right\")\n",
