   ],
   "source": [
    "# ── Mean hits per particle vs pT — all species, from particles_simulation.root ──\n",
    "import uproot\n",
    "import awkward as ak\n",
    "\n",
    "SPECIES_PDG = {\"Electron\": 11, \"Muon\": 13, \"Pion\": 211, \"Proton\": 2212}\n",
    "SPEC_COLORS = {\"Electron\": \"#2ca02c\", \"Muon\": \"#1f77b4\", \"Pion\": \"#ff7f0e\", \"Proton\": \"#d62728\"}\n",
    "SPEC_MARKERS = {\"Electron\": \"^\", \"Muon\": \"o\", \"Pion\": \"s\", \"Proton\": \"D\"}\n",
    "\n",
    "pt_bins = np.linspace(0.1, 0.5, 30)\n",
    "xc = 0.5 * (pt_bins[1:] + pt_bins[:-1])\n",
    "xe = 0.5 * (pt_bins[1:] - pt_bins[:-1])\n",
    "N_BINS = len(pt_bins) - 1\n",
    "\n",
    "with uproot.open(DATA_DIR / \"particles_simulation.root\") as f:\n",
    "    arrs = f[\"particles\"].arrays([\"particle_type\", \"pt\", \"number_of_hits\"], library=\"ak\")\n",
    "pdg_all = np.abs(ak.to_numpy(ak.flatten(arrs[\"particle_type\"])))\n",
    "pt_all  = ak.to_numpy(ak.flatten(arrs[\"pt\"]))\n",
    "nh_all  = ak.to_numpy(ak.flatten(arrs[\"number_of_hits\"])).astype(float)\n",
    "\n",
    "fig, ax = plt.subplots(figsize=FIGSIZE)\n",
    "\n",
    "for species, pdg_code in SPECIES_PDG.items():\n",
    "    sel = (pdg_all == pdg_code) & (pt_all >= pt_bins[0]) & (pt_all < pt_bins[-1])\n",
    "    pt, nh = pt_all[sel], nh_all[sel]\n",
    "    if pt.size == 0:\n",
    "        print(f\"  {species}: no particles found, skipping\")\n",
    "        continue\n",
    "\n",
    "    bins   = np.clip(np.searchsorted(pt_bins, pt, side=\"right\") - 1, 0, N_BINS - 1)\n",
    "    counts = np.bincount(bins, minlength=N_BINS).astype(float)\n",
    "    sums   = np.bincount(bins, weights=nh,      minlength=N_BINS)\n",
    "    sums2  = np.bincount(bins, weights=nh * nh, minlength=N_BINS)\n",
    "    with np.errstate(divide=\"ignore\", invalid=\"ignore\"):\n",
    "        mean = np.where(counts > 0, sums / np.where(counts > 0, counts, 1), np.nan)\n",
    "        var  = np.where(counts > 1,\n",
    "                        (sums2 - counts * mean ** 2) / np.where(counts > 1, counts - 1, 1),\n",
    "                        np.nan)\n",
    "        sem  = np.where(counts > 0,\n",
    "                        np.sqrt(np.maximum(var, 0.0) / np.where(counts > 0, counts, 1)),\n",
    "                        np.nan)\n",
    "\n",
    "    ax.errorbar(xc, mean, xerr=xe, yerr=sem,\n",
    "                fmt=SPEC_MARKERS[species], color=SPEC_COLORS[species],\n",
    "                capsize=CAPSIZE, capthick=1.5, markersize=MARKERSIZE, lw=1.5,\n",
    "                label=species)\n",
    "\n",
    "ax.set_xlabel(r\"$p_T$ [GeV]\", fontsize=FONT_AXIS)\n",
    "ax.set_ylabel(\"Mean hits per particle\", fontsize=FONT_AXIS)\n",
    "ax.tick_params(axis=\"both\", labelsize=FONT_TICK)\n",
    "ax.set_xlim(0.1, 0.5)\n",
    "ax.set_ylim(0, 25)\n",
    "ax.set_yticks(range(0, 25, 2))\n",
    "ax.legend(fontsize=FONT_LEGEND)\n",
    "ax.grid(True, alpha=GRID_ALPHA)\n",
    "fig.tight_layout()\n",
    "\n",
    "out = DATA_DIR / \"mean_hits_per_particle_vs_pt.pdf\"\n",
    "fig.savefig(out, bbox_inches=\"tight\")\n",
    "print(f\"Saved: {out}\")\n",
    "plt.show()\n"
   ]
  },
