      "  0.155   1856    1578   0.468    0.517    1.104\n",
      "  0.165   1899    1757   0.577    0.617    1.070\n",
      "  0.175   1797    1672   0.629    0.670    1.065\n",
      "  0.185   1907    1800   0.647    0.683    1.057\n",
      "  0.195   1905    1673   0.624    0.682    1.093\n",
      "  0.205   1943    1629   0.583    0.661    1.134\n",
      "  0.215   1884    1654   0.644    0.717    1.114\n",
      "  0.225   1918    1742   0.689    0.749    1.088\n",
      "  0.235   1881    1728   0.719    0.777    1.080\n",
      "  0.245   1874    1530   0.613    0.705    1.149\n",
