   "source": [
    "# Per-particle ≥K aggregates: fraction of GT particles with ≥K missed\n",
    "# truth-hits and ≥K holes, vs pT. Both views (UNMATCHED and ALL GT). Muon only.\n",
    "\n",
    "K_VALUES = [1, 2, 3]\n",
    "K_STYLES = {1: \"-\", 2: \"--\", 3: \":\"}\n",
    "K_LW     = {1: 2.0, 2: 2.0, 3: 2.0}\n",
    "\n",
    "species = \"Muon\"\n",
    "\n",
    "def _interp_one_minus_eff(target_centers):\n",
    "    \"\"\"Interpolate (1 - muon KF eff) onto an arbitrary pT centers grid.\n",
    "    Falls back to NaN if cell 3 hasn't been run in this kernel.\"\"\"\n",
    "    if \"mu_eff\" not in globals() or \"eff_pt_centers\" not in globals():\n",
    "        return None\n",
    "    valid = ~np.isnan(mu_eff)\n",
    "    if not np.any(valid):\n",
    "        return None\n",
    "    return 1.0 - np.interp(target_centers,\n",
    "                           eff_pt_centers[valid], mu_eff[valid],\n",
    "                           left=np.nan, right=np.nan)\n",
    "\n",
    "def _seeding_failure_rate(view_src, species_name):\n",
    "    \"\"\"Return seeding-failure rate (1 - n_with_attempt / n_total) per pT bin.\n",
    "\n",
    "    ALL-GT JSON has n_with_attempt directly; UNMATCHED JSON only has\n",
    "    n_matched + n_unmatched, which together equal n_with_attempt.\"\"\"\n",
    "    nt = np.array(view_src[\"n_total\"][species_name], dtype=float)\n",
    "    if \"n_with_attempt\" in view_src:\n",
    "        nwa = np.array(view_src[\"n_with_attempt\"][species_name], dtype=float)\n",
    "    elif \"n_matched\" in view_src and \"n_unmatched\" in view_src:\n",
    "        nwa = (np.array(view_src[\"n_matched\"][species_name],   dtype=float)\n",
    "             + np.array(view_src[\"n_unmatched\"][species_name], dtype=float))\n",
    "    else:\n",
    "        return None\n",
    "    return np.where(nt > 0, 1.0 - nwa / np.where(nt > 0, nt, 1.0), np.nan)\n",
    "\n",
    "for view_label, src, view_tag in [\n",
    "    (\"ALL GT, best attempt\",     allgt, \"all\"),\n",
    "    (\"UNMATCHED GT only\",         attr, \"unmatched\"),\n",
    "]:\n",
    "    if \"n_missed_geq_\" + view_tag not in src:\n",
    "        print(f\"!! '{view_label}' JSON lacks n_missed_geq_{view_tag} / \"\n",
    "              f\"n_holes_geq_{view_tag}. Re-run attribute_holes_per_layer.py.\")\n",
    "        continue\n",
    "\n",
    "    n_total = np.array(src[\"n_total\"][species])\n",
    "    mask    = n_total > 0\n",
    "    one_m_eff = _interp_one_minus_eff(pt_centers)\n",
    "    seed_fail = _seeding_failure_rate(src, species)\n",
    "\n",
    "    for kind_label, key, fname in [\n",
    "        (\"missed truth-hits\",                 \"n_missed_geq_\"       + view_tag, \"n_missed_geq\"),\n",
    "        (\"holes\",                             \"n_holes_geq_\"        + view_tag, \"n_holes_geq\"),\n",
    "        (\"missed layers (no fit measurement)\",\"n_missed_layer_geq_\" + view_tag, \"n_missed_layer_geq\"),\n",
    "    ]:\n",
    "        # Guard: the new \"missed layer\" arrays are only present after the\n",
    "        # updated attribute_holes_per_layer.C has been re-run. Older JSONs\n",
    "        # don't have them — skip silently rather than KeyError.\n",
    "        if key not in src:\n",
    "            print(f\"  ({key} not in JSON; skip — re-run attribute_holes_per_layer.C)\")\n",
    "            continue\n",
    "        arr = np.array(src[key][species])  # shape (K_MAX, N_BINS)\n",
    "        fig, ax = plt.subplots(figsize=FIGSIZE)\n",
    "        for K in K_VALUES:\n",
    "            if K - 1 >= arr.shape[0]:\n",
    "                continue\n",
    "            cnt  = arr[K - 1]\n",
    "            frac = np.where(mask, cnt / np.where(mask, n_total, 1), np.nan)\n",
    "            ax.plot(pt_centers, smooth(frac, SMOOTH_WIN),\n",
    "                    K_STYLES[K], color=\"C0\", linewidth=K_LW[K],\n",
    "                    label=fr\"$\\geq {K}$\")\n",
    "        if one_m_eff is not None:\n",
    "            ax.plot(pt_centers, one_m_eff, color=\"black\",\n",
    "                    linewidth=1.5, alpha=0.8, label=\"1 − KF efficiency\")\n",
    "        if view_tag == \"unmatched\" and seed_fail is not None:\n",
    "            ax.plot(pt_centers, seed_fail, color=\"#888888\",\n",
    "                    linewidth=1.5, linestyle=\"--\", alpha=0.9,\n",
    "                    label=\"Seeding-failure rate\")\n",
    "            # Also show (UNMATCHED ≥1) + seeding-failure: if this tracks 1-eff,\n",
    "            # the staircase is fully attributed (no ghost-match remainder).\n",
    "            if arr.shape[0] >= 1:\n",
    "                combo = (arr[0] / np.where(mask, n_total, 1.0)) + np.where(\n",
    "                    np.isnan(seed_fail), 0.0, seed_fail)\n",
    "                ax.plot(pt_centers, smooth(combo, SMOOTH_WIN),\n",
    "                        color=\"C3\", linewidth=1.5, alpha=0.9,\n",
    "                        label=fr\"$\\geq 1$ + seeding-failure\")\n",
    "        overlay_dips(ax)\n",
    "        ax.set_xlabel(r\"$p_T$ [GeV]\", fontsize=FONT_AXIS)\n",
    "        ax.set_ylabel(f\"Fraction of GT {species.lower()}s\\n\"\n",
    "                      f\"with $\\geq K$ {kind_label}\",\n",
    "                      fontsize=FONT_AXIS)\n",
    "        ax.set_title(f\"{species}: per-particle {kind_label} ≥K vs $p_T$\\n\"\n",
    "                     f\"({view_label}, kept layers only)\",\n",
    "                     fontsize=12)\n",
    "        ax.tick_params(labelsize=FONT_TICK)\n",
    "        ax.legend(fontsize=FONT_LEGEND, loc=\"upper right\")\n",
    "        ax.grid(True, alpha=GRID_ALPHA)\n",
    "        ax.set_xlim(pt_edges[0], pt_edges[-1])\n",
    "        ax.set_ylim(0, 1.0)\n",
    "        fig.tight_layout()\n",
    "        out = ALL_JSON.parent / f\"{fname}_{view_tag}_{species.lower()}_replot.pdf\"\n",
    "        fig.savefig(out, bbox_inches=\"tight\", dpi=DPI)\n",
    "        print(f\"Saved: {out}\")\n",
    "        plt.show()\n"
   ]
  },
  {
   "cell_type": "markdown",
   "metadata": {},
   "source": [
    "## Absolute-count view (Muon, ALL GT)\n",
    "\n",
    "The Mode 2 ratio `miss_num / miss_den` is conditional on a layer being truly hit, so a low denominator\n",
    "(few particles even reach the layer in that pT bin) inflates the ratio. To check whether the staircase\n",
    "dips line up with the actual *number* of failures, plot the raw numerator counts straight from the JSON:\n",
    "\n",
    "- **Mode 1 abs:** total holes per layer per pT bin — `holes_all[Muon][lay][b]` (no normalisation).\n",
    "- **Mode 2 abs:** number of GT muon particles whose truth hit on a layer was missed by the KF — `miss_num_all[Muon][lay][b]`.\n",
    "\n",
    "Dashed verticals are the staircase dips from cell 3."
   ]
  },
  {
