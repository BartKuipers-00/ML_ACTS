      "pT bin | d_orig | d_clean | eff_orig | eff_clean | ratio\n",
      "  0.105   1843    1721   0.282    0.297    1.052\n",
      "  0.115   1968    1718   0.323    0.360    1.113\n",
      "  0.125   1890    1823   0.470    0.485    1.033\n",
