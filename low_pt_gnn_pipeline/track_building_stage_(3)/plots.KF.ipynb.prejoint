   "source": [
    "# ── CKF fake rate vs reconstructed pT — clean, axis 0.0–0.55 ─────────────\n",
    "# Loads fake_rate_per_pt.json (produced by\n",
    "# acts/output_examples/helpers/fake_rate_per_pt.C).\n",
    "#\n",
    "# A track is \"fake\" if it has NO matchingdetails row with matched=True\n",
    "# (i.e., no truth particle dominates >= matchingFractionThreshold of its\n",
    "# hits; threshold = 0.7 in our config).\n",
    "\n",
    "_FR_JSON = DATA_DIR / \"fake_rate_per_pt.json\"\n",
    "with open(_FR_JSON) as _f:\n",
    "    _fr = json.load(_f)\n",
    "\n",
    "_fr_centers = np.array(_fr[\"pt_centers\"])\n",
    "_fr_edges   = np.array(_fr[\"pt_edges\"])\n",
    "\n",
    "tot = np.array(_fr[\"n_total_nocut\"], dtype=float)\n",
    "fk  = np.array(_fr[\"n_fake_nocut\"],  dtype=float)\n",
    "valid = tot > 0\n",
    "fr = np.where(valid, fk / np.where(valid, tot, 1), np.nan)\n",
    "\n",
    "fig, ax = plt.subplots(figsize=FIGSIZE)\n",
    "half_w = 0.5 * (_fr_edges[1] - _fr_edges[0])\n",
    "ax.errorbar(_fr_centers[valid], fr[valid], xerr=half_w,\n",
    "            fmt=\"o\", color=\"black\",\n",
    "            markersize=3, capsize=CAPSIZE, capthick=1.2,\n",
    "            label=\"CKF\")\n",
    "\n",
    "ax.set_xlabel(r\"$p_T$ [GeV]\", fontsize=FONT_AXIS)\n",
    "ax.set_ylabel(\"Fake rate\", fontsize=FONT_AXIS)\n",
    "ax.tick_params(labelsize=FONT_TICK)\n",
    "ax.set_xlim(0.0, 0.55)\n",
    "ax.set_xticks(np.arange(0.1, 0.51, 0.1))\n",
    "ax.set_xticks(np.arange(0.05, 0.51, 0.1), minor=True)\n",
    "ax.set_ylim(0.0, 1.05)\n",
    "ax.grid(True, which=\"both\", alpha=GRID_ALPHA)\n",
    "ax.legend(fontsize=FONT_LEGEND, loc=\"upper left\")\n",
    "fig.tight_layout()\n",
    "\n",
    "out = DATA_DIR / \"fake_rate_vs_pt.pdf\"\n",
    "fig.savefig(out, bbox_inches=\"tight\", dpi=DPI)\n",
    "print(f\"Saved: {out}\")\n",
    "plt.show()\n"
   ]
  },
