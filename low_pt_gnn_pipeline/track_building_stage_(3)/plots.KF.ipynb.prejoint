   "source": [
    "# ── Outermost-layer correct-hits fraction: of all GT muons with a KF attempt\n",
    "#    and a known outermost-r truth layer, what fraction has the best KF track\n",
    "#    correctly anchoring measurements on that layer?\n",
    "#\n",
    "# Two definitions plotted side-by-side:\n",
    "#   \"any\"   : best KF has >=1 Measurement state on outer (vol, lay) whose\n",
    "#             particle_ids list contains this GT particle's id.\n",
    "#   \"exact\" : # of best-KF Measurement states on outer layer matching this\n",
    "#             pid == # truth hits this particle has on that layer, AND no\n",
    "#             foreign measurements on that layer (perfect purity + count).\n",
    "\n",
    "_co = _allgt[\"outermost_correct_hits\"]\n",
    "co_pt_centers = np.array(_co[\"pt_centers\"])\n",
    "co_pt_edges   = np.array(_co[\"pt_edges\"])\n",
    "co_den       = np.array(_co[\"den\"][\"Muon\"],       dtype=float)\n",
    "co_num_any   = np.array(_co[\"num_any\"][\"Muon\"],   dtype=float)\n",
    "co_num_exact = np.array(_co[\"num_exact\"][\"Muon\"], dtype=float)\n",
    "\n",
    "with np.errstate(divide=\"ignore\", invalid=\"ignore\"):\n",
    "    co_any   = np.where(co_den > 0, co_num_any   / np.where(co_den > 0, co_den, 1), np.nan)\n",
    "    co_exact = np.where(co_den > 0, co_num_exact / np.where(co_den > 0, co_den, 1), np.nan)\n",
    "    co_any_err = np.where(co_den > 0,\n",
    "                          np.sqrt(np.maximum(co_any * (1 - co_any), 0.0) /\n",
    "                                  np.where(co_den > 0, co_den, 1)), np.nan)\n",
    "    co_exact_err = np.where(co_den > 0,\n",
    "                            np.sqrt(np.maximum(co_exact * (1 - co_exact), 0.0) /\n",
    "                                    np.where(co_den > 0, co_den, 1)), np.nan)\n",
    "\n",
    "assert np.allclose(co_pt_centers, eff_pt_centers), \\\n",
    "    \"outermost_correct_hits pT axis does not match eff_per_particle.json\"\n",
    "\n",
    "fig, ax = plt.subplots(figsize=FIGSIZE)\n",
    "half_w = 0.5 * (co_pt_edges[1] - co_pt_edges[0])\n",
    "valid = co_den > 0\n",
    "\n",
    "ax.errorbar(co_pt_centers[valid], co_any[valid],\n",
    "            xerr=half_w, yerr=co_any_err[valid],\n",
    "            fmt=\"o\", color=\"#2ca02c\", markersize=3,\n",
    "            capsize=CAPSIZE, capthick=1.2,\n",
    "            label=r\"$\\geq$1 correct measurement (any)\")\n",
    "ax.errorbar(co_pt_centers[valid], co_exact[valid],\n",
    "            xerr=half_w, yerr=co_exact_err[valid],\n",
    "            fmt=\"s\", color=\"#1f77b4\", markersize=3,\n",
    "            capsize=CAPSIZE, capthick=1.2,\n",
    "            label=\"exact count + 100% purity\")\n",
    "\n",
    "overlay_dips(ax, label=\"staircase dip (muon-derived)\")\n",
    "for lay, thr in dip_layers:\n",
    "    ax.axvline(thr, color=\"grey\", linestyle=\":\", linewidth=1.0, alpha=0.5)\n",
    "\n",
    "ax.set_xlabel(r\"$p_T$ [GeV]\", fontsize=FONT_AXIS)\n",
    "ax.set_ylabel(\"Fraction with correct hits on outermost-r GT layer\",\n",
    "              fontsize=FONT_AXIS)\n",
    "ax.set_title(\"Correct-hit fraction on outermost-r GT layer (best KF attempt)\",\n",
    "             fontsize=12)\n",
    "ax.tick_params(labelsize=FONT_TICK)\n",
    "ax.set_xlim(co_pt_edges[0], co_pt_edges[-1])\n",
    "ax.set_ylim(0.0, 1.05)\n",
    "ax.grid(True, alpha=GRID_ALPHA)\n",
    "ax.legend(fontsize=FONT_LEGEND, loc=\"lower right\")\n",
    "fig.tight_layout()\n",
    "out = ALL_GT_JSON.parent / \"outermost_correct_hits_muon.pdf\"\n",
    "fig.savefig(out, bbox_inches=\"tight\", dpi=DPI)\n",
    "print(f\"Saved: {out}\")\n",
    "\n",
    "print(\"\")\n",
    "print(\"pT bin |  den  | num_any | num_exact | any   | exact\")\n",
    "for i in range(len(co_pt_centers)):\n",
    "    if co_den[i] == 0:\n",
    "        continue\n",
    "    print(f\"  {co_pt_centers[i]:.3f}  {int(co_den[i]):5d}   \"\n",
    "          f\"{int(co_num_any[i]):5d}    {int(co_num_exact[i]):5d}    \"\n",
    "          f\"{co_any[i]:.3f}   {co_exact[i]:.3f}\")\n",
    "plt.show()\n"
   ]
