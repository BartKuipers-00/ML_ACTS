     },
     "metadata": {},
     "output_type": "display_data"
    }
   ],
   "source": [
    "# ── Efficiency vs pT: Triplet seeding, +CKF, SegmentGNN, helix (4 curves) ─────\n",
    "# All curves species-averaged (macro-avg) on the SegmentGNN pT grid, binned by\n",
    "# truth pT. Seeding/CKF from the ACTS per-particle JSONs; the two GNN builders\n",
    "# from their efficiency_vs_pt_*.json (per-species series already on the grid).\n",
    "# Self-contained: imports + style + paths defined here.\n",
    "import json\n",
    "from pathlib import Path\n",
    "import numpy as np\n",
    "import scipy.stats\n",
    "import matplotlib.pyplot as plt\n",
    "from matplotlib.ticker import MultipleLocator\n",
    "\n",
    "# ── Style (falls back to defaults if the notebook setup cell wasn't run) ──────\n",
    "FIGSIZE      = globals().get(\"FIGSIZE\", (7, 5))\n",
    "FONT_AXIS    = globals().get(\"FONT_AXIS\", 18)\n",
    "FONT_TICK    = globals().get(\"FONT_TICK\", 14)\n",
    "FONT_LEGEND  = globals().get(\"FONT_LEGEND\", 14)\n",
    "CAPSIZE      = globals().get(\"CAPSIZE\", 3)\n",
    "GRID_ALPHA   = globals().get(\"GRID_ALPHA\", 0.3)\n",
    "MS_P1        = globals().get(\"MS_P1\", 4)\n",
    "ANNO_LINE_DY = globals().get(\"ANNO_LINE_DY\", 0.07)\n",
    "DPI          = globals().get(\"DPI\", 150)\n",
    "CKF_DIR      = globals().get(\"DATA_DIR\",\n",
    "    Path(\"/data/alice/bkuipers/acts/output_examples/CKF_300_mixed_helix_1000_events/clean\"))\n",
    "\n",
    "_FR_DATA_ROOT = Path(\"/data/alice/bkuipers/low_pt_gnn_pipeline/data_300_mixed\")\n",
    "_SPECIES = [\"Electron\", \"Muon\", \"Pion\", \"Proton\"]\n",
    "# ── pT grid: the SegmentGNN efficiency grid (29 bins, 0.1-0.5 GeV) ───────────\n",
    "_SGNN_EFF = _FR_DATA_ROOT / \"visuals/track_metrics/testset_SegmentGNN_minlen7/efficiency_vs_pt_testset_SegmentGNN_minlen7.json\"\n",
    "_HELIX_EFF = _FR_DATA_ROOT / \"visuals/track_metrics/testset_helix_minlen7/efficiency_vs_pt_testset_helix_minlen7.json\"\n",
    "_egnn = next(s for s in json.load(open(_SGNN_EFF))[\"series\"] if s.get(\"label\", \"\").startswith(\"Electron\"))\n",
    "EGX  = np.array(_egnn[\"x\"], float)\n",
    "EGXE = np.array(_egnn[\"xerr\"], float)\n",
    "EG_EDGES = np.concatenate([EGX - EGXE, [EGX[-1] + EGXE[-1]]])\n",
    "\n",
    "def _eff_cp(passed, total, level=0.68):\n",
    "    a = (1 - level) / 2\n",
    "    passed = np.asarray(passed, float); total = np.asarray(total, float)\n",
    "    lo = np.where(passed > 0, scipy.stats.beta.ppf(a, passed, total - passed + 1), 0.0)\n",
    "    hi = np.where(passed < total, scipy.stats.beta.ppf(1 - a, passed + 1, total - passed), 1.0)\n",
    "    eff = np.where(total > 0, passed / np.where(total > 0, total, 1), np.nan)\n",
    "    return np.maximum(0, eff - lo), np.maximum(0, hi - eff)\n",
    "\n",
    "def _eff_rebin(num, den, centers):\n",
    "    n = np.zeros(len(EGX)); d = np.zeros(len(EGX))\n",
    "    for i, c in enumerate(centers):\n",
    "        b = int(np.searchsorted(EG_EDGES, c, side=\"right\") - 1)\n",
    "        if 0 <= b < len(EGX):\n",
    "            n[b] += num[i]; d[b] += den[i]\n",
    "    return n, d\n",
    "\n",
    "def _macro(eff_stack, lo_stack, hi_stack):\n",
    "    es, ls, hs = np.vstack(eff_stack), np.vstack(lo_stack), np.vstack(hi_stack)\n",
    "    with np.errstate(invalid=\"ignore\"):\n",
    "        em = np.nanmean(es, axis=0)\n",
    "        nval = np.sum(np.isfinite(es), axis=0)\n",
    "        lm = np.sqrt(np.nansum(ls ** 2, axis=0)) / np.where(nval > 0, nval, 1)\n",
    "        hm = np.sqrt(np.nansum(hs ** 2, axis=0)) / np.where(nval > 0, nval, 1)\n",
    "    return em, lm, hm, nval == len(_SPECIES)\n",
    "\n",
    "def _macro_from_counts(data):\n",
    "    \"\"\"ACTS per-particle JSON (num/den per species) -> species-averaged eff.\"\"\"\n",
    "    centers = np.array(data[\"pt_centers\"], float)\n",
    "    es, ls, hs = [], [], []\n",
    "    for s in _SPECIES:\n",
    "        n, d = _eff_rebin(np.array(data[\"num\"][s], float),\n",
    "                          np.array(data[\"den\"][s], float), centers)\n",
    "        v = d > 0\n",
    "        es.append(np.where(v, n / np.where(v, d, 1), np.nan))\n",
    "        lo, hi = _eff_cp(n, d)\n",
    "        ls.append(np.where(v, lo, np.nan)); hs.append(np.where(v, hi, np.nan))\n",
    "    return _macro(es, ls, hs)\n",
    "\n",
    "def _macro_from_series(json_path):\n",
    "    \"\"\"GNN efficiency_vs_pt JSON (per-species y on the grid) -> species-averaged.\"\"\"\n",
    "    by = {s[\"label\"].split(\" \")[0]: s for s in json.load(open(json_path))[\"series\"]}\n",
    "    def _arr(s, k): return np.array([np.nan if v is None else v for v in s[k]], float)\n",
    "    es, ls, hs = [], [], []\n",
    "    for sp in _SPECIES:\n",
    "        s = by[sp]\n",
    "        es.append(_arr(s, \"y\")); ls.append(_arr(s, \"yerr_lo\")); hs.append(_arr(s, \"yerr_hi\"))\n",
    "    return _macro(es, ls, hs)\n",
    "\n",
    "seed_eff  = _macro_from_counts(json.load(open(CKF_DIR / \"seeding_eff_per_particle.json\")))\n",
    "ckf_eff   = _macro_from_counts(json.load(open(CKF_DIR / \"eff_per_particle.json\")))\n",
    "sgnn_eff  = _macro_from_series(_SGNN_EFF)\n",
    "helix_eff = _macro_from_series(_HELIX_EFF)\n",
    "\n",
    "# ── Plot (style matches the fake-rate figure) ────────────────────────────────\n",
    "fig, ax_p = plt.subplots(figsize=FIGSIZE)\n",
    "def _draw(res, fmt, color, label):\n",
    "    em, lm, hm, mask = res\n",
    "    ax_p.errorbar(EGX[mask], em[mask], xerr=EGXE[mask], yerr=[lm[mask], hm[mask]],\n",
    "                  fmt=fmt, color=color, markersize=MS_P1, capsize=CAPSIZE, capthick=1,\n",
    "                  label=label)\n",
    "_draw(seed_eff,  \"D\", \"#7f7f7f\", \"Triplet seeding\")\n",
    "_draw(ckf_eff,   \"s\", \"#c0392b\", \"Triplet seeding + CKF\")\n",
    "_draw(sgnn_eff,  \"^\", \"#1f3a68\", \"GNN + SegmentGNN\")\n",
    "_draw(helix_eff, \"o\", \"#5c3317\", \"GNN + helix matching\")\n",
    "\n",
    "ax_p.set_xlabel(r\"$p_T$ [GeV]\", fontsize=FONT_AXIS)\n",
    "ax_p.set_ylabel(\"Efficiency\", fontsize=FONT_AXIS)\n",
    "\n",
    "# auto-fit x to the data range + 8% padding (same as the SegmentGNN plots)\n",
    "_lo, _hi = float(EG_EDGES[0]), float(EG_EDGES[-1])\n",
    "_pad = max((_hi - _lo) * 0.08, 0.02)\n",
    "ax_p.set_xlim(_lo - _pad, _hi + _pad)\n",
    "\n",
    "ax_p.xaxis.set_minor_locator(MultipleLocator(0.05))   # faint minor grid every 0.05\n",
    "ax_p.set_ylim(0.0, 1.05)\n",
    "ax_p.tick_params(labelsize=FONT_TICK - 1)\n",
    "ax_p.grid(True, alpha=GRID_ALPHA)\n",
    "ax_p.grid(True, which=\"minor\", axis=\"x\", alpha=GRID_ALPHA * 0.5)\n",
    "ax_p.legend(fontsize=FONT_LEGEND - 1, loc=\"lower right\", frameon=False)\n",
    "\n",
    "# Annotation block (upper-left; efficiency is low there at low pT).\n",
    "# _anno = (0.04, 0.96)\n",
    "# _anno_kw = dict(transform=ax_p.transAxes, va=\"top\", ha=\"left\",\n",
    "#                 bbox=dict(facecolor=\"white\", edgecolor=\"none\", alpha=0.85, pad=2))\n",
    "# ax_p.text(_anno[0], _anno[1],                    r\"$\\mathbf{Generic \\ Detector}$ Simulation\",\n",
    "#           fontsize=FONT_AXIS - 3, **_anno_kw)\n",
    "# ax_p.text(_anno[0], _anno[1] -     ANNO_LINE_DY, \"FATRAS, 300 particles / event\",\n",
    "#           fontsize=FONT_AXIS - 5, style=\"italic\", **_anno_kw)\n",
    "# ax_p.text(_anno[0], _anno[1] - 2 * ANNO_LINE_DY, r\"$|\\eta| < 0.15$, species-averaged\",\n",
    "#           fontsize=FONT_AXIS - 5, style=\"italic\", **_anno_kw)\n",
    "\n",
    "fig.tight_layout()\n",
    "out = _FR_DATA_ROOT / \"visuals/track_metrics/efficiency_seeding_ckf_gnn_vs_pt.pdf\"\n",
    "fig.savefig(out, bbox_inches=\"tight\", dpi=DPI)\n",
    "print(f\"Saved: {out}\")\n",
    "for name, res in [(\"seeding\", seed_eff), (\"CKF\", ckf_eff),\n",
    "                  (\"SegmentGNN\", sgnn_eff), (\"helix\", helix_eff)]:\n",
    "    em, _, _, mask = res\n",
    "    print(f\"  mean eff ({name}): {np.nanmean(em[mask]):.3f}\")\n",
    "plt.show()\n"
   ]
  },
