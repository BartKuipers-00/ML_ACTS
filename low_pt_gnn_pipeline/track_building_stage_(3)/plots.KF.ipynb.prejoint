    }
   ],
   "source": [
    "# ── Triplet seeding efficiency vs pT — per species + macro-average ──────\n",
    "# Per-species curves + \"All species (avg)\" = unweighted mean of per-species\n",
    "# efficiencies (each species weighted equally, NOT by particle count).\n",
    "# This avoids shifts driven by changes in species composition across pT bins.\n",
    "\n",
    "fig, ax = plt.subplots(figsize=FIGSIZE)\n",
    "\n",
    "_all_species = [\"Electron\", \"Muon\", \"Pion\", \"Proton\"]\n",
    "\n",
    "# Per-species rebinned curves\n",
    "species_eff = {}\n",
    "species_yerr = {}\n",
    "for species in _all_species:\n",
    "    n, d = _rebin_to_gnn(np.array(seed_data[\"num\"][species], float),\n",
    "                         np.array(seed_data[\"den\"][species], float),\n",
    "                         acts_pt_centers_p1)\n",
    "    valid = d > 0\n",
    "    eff = np.where(valid, n / np.where(valid, d, 1), np.nan)\n",
    "    lo, hi = _kf_cp_err(n, d)\n",
    "    species_eff[species] = eff\n",
    "    species_yerr[species] = (lo, hi)\n",
    "    ax.errorbar(gnn_x[valid], eff[valid],\n",
    "                xerr=gnn_xerr[valid],\n",
    "                yerr=[lo[valid], hi[valid]],\n",
    "                fmt=SPECIES_MARKER[species],\n",
    "                color=SPECIES_COLOR[species],\n",
    "                markersize=MS_P1, capsize=CAPSIZE, capthick=1,\n",
    "                label=species)\n",
    "\n",
    "# Macro-average: mean over species of the per-species efficiencies.\n",
    "eff_stack = np.vstack([species_eff[s] for s in _all_species])\n",
    "lo_stack  = np.vstack([species_yerr[s][0] for s in _all_species])\n",
    "hi_stack  = np.vstack([species_yerr[s][1] for s in _all_species])\n",
    "\n",
    "with np.errstate(invalid=\"ignore\"):\n",
    "    eff_macro = np.nanmean(eff_stack, axis=0)\n",
    "    n_valid   = np.sum(np.isfinite(eff_stack), axis=0)\n",
    "    lo_macro  = np.sqrt(np.nansum(lo_stack**2, axis=0)) / np.where(n_valid > 0, n_valid, 1)\n",
    "    hi_macro  = np.sqrt(np.nansum(hi_stack**2, axis=0)) / np.where(n_valid > 0, n_valid, 1)\n",
    "\n",
    "mask = n_valid == len(_all_species)\n",
    "ax.errorbar(gnn_x[mask], eff_macro[mask],\n",
    "            xerr=gnn_xerr[mask],\n",
    "            yerr=[lo_macro[mask], hi_macro[mask]],\n",
    "            fmt=\"*\", color=\"black\",\n",
    "            markersize=MS_P1 + 3, capsize=CAPSIZE, capthick=1,\n",
    "            label=\"All species (avg)\")\n",
    "\n",
    "ax.set_xlabel(r\"$p_T$ [GeV]\", fontsize=FONT_AXIS)\n",
    "ax.set_ylabel(\"Triplet seeding efficiency\", fontsize=FONT_AXIS)\n",
    "ax.set_xlim(0.0, 0.55)\n",
    "ax.set_xticks(np.arange(0.1, 0.51, 0.1))\n",
    "ax.set_xticks(np.arange(0.05, 0.51, 0.1), minor=True)\n",
    "ax.set_ylim(0.0, 1.05)\n",
    "ax.tick_params(labelsize=FONT_TICK - 1)\n",
    "ax.grid(True, which=\"both\", alpha=GRID_ALPHA)\n",
    "ax.legend(fontsize=FONT_LEGEND - 3, loc=\"lower right\", frameon=False)\n",
    "\n",
    "ANNO_ANCHOR = (0.04, 0.25)\n",
    "_anno_box = dict(facecolor=\"white\", edgecolor=\"none\", alpha=0.85, pad=2)\n",
    "_ax, _ay = ANNO_ANCHOR\n",
    "_anno_kw = dict(transform=ax.transAxes, va=\"top\", ha=ANNO_HA, bbox=_anno_box)\n",
    "ax.text(_ax, _ay,                       r\"$\\mathbf{ODD}$ Simulation\",\n",
    "        fontsize=FONT_AXIS - 3, **_anno_kw)\n",
    "ax.text(_ax, _ay -  ANNO_LINE_DY,    \"FATRAS, 300 particles / event\",\n",
    "        fontsize=FONT_AXIS - 5, style=\"italic\", **_anno_kw)\n",
    "ax.text(_ax, _ay - 2 * ANNO_LINE_DY,    r\"$|\\eta| < 0.15$, reconstructable particles\",\n",
    "        fontsize=FONT_AXIS - 5, style=\"italic\", **_anno_kw)\n",
    "\n",
    "fig.tight_layout()\n",
    "out = DATA_DIR / \"eff_seeding_per_species_replot.pdf\"\n",
    "fig.savefig(out, bbox_inches=\"tight\", dpi=DPI)\n",
    "print(f\"Saved: {out}\")\n",
    "plt.show()\n"
   ]
  },
