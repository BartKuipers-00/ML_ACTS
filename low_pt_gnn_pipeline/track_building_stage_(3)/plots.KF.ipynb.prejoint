   "source": [
    "# ── KF efficiency vs pT (all species) — matching fraction 0.5 (not 0.7) ──\n",
    "# Identical to the per-species efficiency plot above, but assuming a 50%\n",
    "# two-way matching fraction instead of the production 0.7. Data:\n",
    "# eff_per_particle_mf50.json, produced by\n",
    "#   create_eff_per_particle.C+(-1, \"<dir>/\", 0.5)\n",
    "# which recomputes the match as purity >= 0.5 AND completeness >= 0.5 from\n",
    "# the matchingdetails tree (the denominator / reconstructable set is\n",
    "# unchanged, so only the numerator differs from the 0.7 plot).\n",
    "\n",
    "EFF_JSON_MF50 = DATA_DIR / \"eff_per_particle_mf50.json\"\n",
    "\n",
    "with open(EFF_JSON_MF50) as f:\n",
    "    eff_data_mf50 = json.load(f)\n",
    "\n",
    "eff_pt_centers = np.array(eff_data_mf50[\"pt_centers\"])\n",
    "eff_pt_edges   = np.array(eff_data_mf50[\"pt_edges\"])\n",
    "\n",
    "SPECIES_LIST   = [\"Electron\", \"Muon\", \"Pion\", \"Proton\"]\n",
    "SPECIES_COLOR  = {\"Electron\": \"#2ca02c\", \"Muon\": \"#1f77b4\",\n",
    "                  \"Pion\": \"#ff7f0e\", \"Proton\": \"#d62728\"}\n",
    "SPECIES_MARKER = {\"Electron\": \"^\", \"Muon\": \"o\", \"Pion\": \"s\", \"Proton\": \"D\"}\n",
    "\n",
    "fig, ax = plt.subplots(figsize=FIGSIZE)\n",
    "half_w = 0.5 * (eff_pt_edges[1] - eff_pt_edges[0])\n",
    "for s in SPECIES_LIST:\n",
    "    den = np.array(eff_data_mf50[\"den\"][s], dtype=float)\n",
    "    num = np.array(eff_data_mf50[\"num\"][s], dtype=float)\n",
    "    eff_s = np.where(den > 0, num / np.where(den > 0, den, 1), np.nan)\n",
    "    valid = den > 0\n",
    "    ax.errorbar(eff_pt_centers[valid], eff_s[valid], xerr=half_w,\n",
    "                fmt=SPECIES_MARKER[s], color=SPECIES_COLOR[s],\n",
    "                markersize=3, capsize=CAPSIZE, capthick=1.2, label=s)\n",
    "\n",
    "ax.set_xlabel(r\"$p_T$ [GeV]\", fontsize=FONT_AXIS)\n",
    "ax.set_ylabel(\"Efficiency\", fontsize=FONT_AXIS)\n",
    "ax.tick_params(labelsize=FONT_TICK)\n",
    "ax.set_xlim(0.0, 0.55)\n",
    "ax.set_xticks(np.arange(0.1, 0.51, 0.1))\n",
    "ax.set_xticks(np.arange(0.05, 0.51, 0.1), minor=True)\n",
    "ax.set_ylim(0.0, 1.05)\n",
    "ax.grid(True, which=\"both\", alpha=GRID_ALPHA)\n",
    "ax.legend(fontsize=FONT_LEGEND, loc=\"upper left\")\n",
    "fig.tight_layout()\n",
    "\n",
    "out = EFF_JSON_MF50.parent / \"eff_clean_mf50_replot.pdf\"\n",
    "fig.savefig(out, bbox_inches=\"tight\", dpi=DPI)\n",
    "print(f\"Saved: {out}\")\n",
    "plt.show()\n"
   ]
