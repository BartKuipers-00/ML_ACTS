    },
    {
     "data": {
      "image/png": "",
      "text/plain": [
       "<Figure size 700x500 with 1 Axes>"
      ]
     },
     "metadata": {},
     "output_type": "display_data"
    }
   ],
   "source": [
    "# ── Per-layer >=1 correct-hit fraction vs pT (Muon, selected layers) ─\n",
    "# Loads correct_hits_per_layer.json (produced by\n",
    "# acts/output_examples/helpers/correct_hits_per_layer.C). Restricted to\n",
    "# the same 5 layers + colour scheme as the KF-uncertainty plot.\n",
    "\n",
    "_CHPL_JSON = DATA_DIR / \"correct_hits_per_layer.json\"\n",
    "with open(_CHPL_JSON) as _f:\n",
    "    _chpl = json.load(_f)\n",
    "\n",
    "_chpl_centers = np.array(_chpl[\"pt_centers\"])\n",
    "_chpl_edges   = np.array(_chpl[\"pt_edges\"])\n",
    "_chpl_half    = 0.5 * (_chpl_edges[1] - _chpl_edges[0])\n",
    "\n",
    "KF_LAYERS_CHPL = {\n",
    "    \"V17L4\": ((17, 4), 1020, \"#8b0000\"),\n",
    "    \"V17L2\": ((17, 2),  820, \"#d62728\"),\n",
    "    \"V13L8\": ((13, 8),  660, \"#2ca02c\"),\n",
    "    \"V13L6\": ((13, 6),  500, \"#ff7f0e\"),\n",
    "    \"V13L4\": ((13, 4),  360, \"#9467bd\"),\n",
    "}\n",
    "\n",
    "fig, ax = plt.subplots(figsize=FIGSIZE)\n",
    "for name, ((V, L), r_nom, color) in KF_LAYERS_CHPL.items():\n",
    "    num = np.array(_chpl[\"num\"][\"Muon\"][name], dtype=float)\n",
    "    den = np.array(_chpl[\"den\"][\"Muon\"][name], dtype=float)\n",
    "    # Drop bins with < 3% of this layer's peak count (per species).\n",
    "    _peak = den.max() if den.size else 0.0\n",
    "    valid = (den > 0) & (den >= 0.01 * _peak)\n",
    "    if not valid.any(): continue\n",
    "    eff = np.where(valid, num / np.where(valid, den, 1), np.nan)\n",
    "    err = np.where(valid,\n",
    "                   np.sqrt(np.maximum(eff * (1 - eff), 0.0)\n",
    "                           / np.where(valid, den, 1)),\n",
    "                   np.nan)\n",
    "    ax.errorbar(_chpl_centers[valid], eff[valid],\n",
    "                xerr=_chpl_half, yerr=err[valid],\n",
    "                fmt=\"o\", color=color, markersize=3,\n",
    "                capsize=CAPSIZE, capthick=1.0,\n",
    "                label=r\"%s ($r \\approx$ %d mm)\" % (name, r_nom))\n",
    "    # Theoretical layer-reach pT threshold (apex grazes the layer at 2R = r).\n",
    "    _thr = 0.3 * 2.0 * (r_nom * 1e-3) / 2.0\n",
    "    ax.axvline(_thr, color=color, linestyle=\"--\", linewidth=1.0,\n",
    "               alpha=0.6, zorder=0)\n",
    "\n",
    "ax.set_xlabel(r\"$p_T$ [GeV]\", fontsize=FONT_AXIS)\n",
    "ax.set_ylabel(r\"Layer hit efficiency\",\n",
    "              fontsize=FONT_AXIS)\n",
    "ax.tick_params(labelsize=FONT_TICK)\n",
    "ax.set_xlim(0.05, 0.52)\n",
    "ax.set_ylim(0.0, 1.05)\n",
    "ax.grid(True, alpha=GRID_ALPHA)\n",
    "ax.legend(fontsize=FONT_LEGEND - 1, loc=\"lower right\", frameon=False)\n",
    "fig.tight_layout()\n",
    "out = DATA_DIR / \"correct_hits_per_layer_vs_pt_muon.pdf\"\n",
    "fig.savefig(out, bbox_inches=\"tight\", dpi=DPI)\n",
    "print(f\"Saved: {out}\")\n",
    "plt.show()\n"
   ]
  },
