   "source": [
    "# ── Second-outermost-layer correct-hits fraction: same metric as cell 9 but\n",
    "#    keyed on the 2nd-outermost-r truth layer of each GT muon.\n",
    "#\n",
    "#   \"any\"   : best KF has >=1 Measurement state on 2nd-outer (vol, lay) whose\n",
    "#             particle_ids list contains this GT particle's id.\n",
    "#   \"exact\" : # of best-KF Measurement states on 2nd-outer matching this pid\n",
    "#             == # truth hits this particle has on that layer, AND no foreign\n",
    "#             measurements on that layer (perfect purity + count).\n",
    "\n",
    "_co2 = _allgt[\"second_outermost_correct_hits\"]\n",
    "co2_pt_centers = np.array(_co2[\"pt_centers\"])\n",
    "co2_pt_edges   = np.array(_co2[\"pt_edges\"])\n",
    "co2_den       = np.array(_co2[\"den\"][\"Muon\"],       dtype=float)\n",
    "co2_num_any   = np.array(_co2[\"num_any\"][\"Muon\"],   dtype=float)\n",
    "co2_num_exact = np.array(_co2[\"num_exact\"][\"Muon\"], dtype=float)\n",
    "\n",
    "with np.errstate(divide=\"ignore\", invalid=\"ignore\"):\n",
    "    co2_any   = np.where(co2_den > 0, co2_num_any   / np.where(co2_den > 0, co2_den, 1), np.nan)\n",
    "    co2_exact = np.where(co2_den > 0, co2_num_exact / np.where(co2_den > 0, co2_den, 1), np.nan)\n",
    "    co2_any_err = np.where(co2_den > 0,\n",
    "                           np.sqrt(np.maximum(co2_any * (1 - co2_any), 0.0) /\n",
    "                                   np.where(co2_den > 0, co2_den, 1)), np.nan)\n",
    "    co2_exact_err = np.where(co2_den > 0,\n",
    "                             np.sqrt(np.maximum(co2_exact * (1 - co2_exact), 0.0) /\n",
    "                                     np.where(co2_den > 0, co2_den, 1)), np.nan)\n",
    "\n",
    "assert np.allclose(co2_pt_centers, eff_pt_centers), \\\n",
    "    \"second_outermost_correct_hits pT axis does not match eff_per_particle.json\"\n",
    "\n",
    "fig, ax = plt.subplots(figsize=FIGSIZE)\n",
    "half_w = 0.5 * (co2_pt_edges[1] - co2_pt_edges[0])\n",
    "valid = co2_den > 0\n",
    "\n",
    "ax.errorbar(co2_pt_centers[valid], co2_any[valid],\n",
    "            xerr=half_w, yerr=co2_any_err[valid],\n",
    "            fmt=\"o\", color=\"#2ca02c\", markersize=3,\n",
    "            capsize=CAPSIZE, capthick=1.2,\n",
    "            label=r\"$\\geq$1 correct measurement (any)\")\n",
    "ax.errorbar(co2_pt_centers[valid], co2_exact[valid],\n",
    "            xerr=half_w, yerr=co2_exact_err[valid],\n",
    "            fmt=\"s\", color=\"#1f77b4\", markersize=3,\n",
    "            capsize=CAPSIZE, capthick=1.2,\n",
    "            label=\"exact count + 100% purity\")\n",
    "\n",
    "overlay_dips(ax, label=\"staircase dip (muon-derived)\")\n",
    "for lay, thr in dip_layers:\n",
    "    ax.axvline(thr, color=\"grey\", linestyle=\":\", linewidth=1.0, alpha=0.5)\n",
    "\n",
    "ax.set_xlabel(r\"$p_T$ [GeV]\", fontsize=FONT_AXIS)\n",
    "ax.set_ylabel(\"Fraction with correct hits on 2nd-outermost-r GT layer\",\n",
    "              fontsize=FONT_AXIS)\n",
    "ax.set_title(\"Correct-hit fraction on 2nd-outermost-r GT layer (best KF attempt)\",\n",
    "             fontsize=12)\n",
    "ax.tick_params(labelsize=FONT_TICK)\n",
    "ax.set_xlim(co2_pt_edges[0], co2_pt_edges[-1])\n",
    "ax.set_ylim(0.0, 1.05)\n",
    "ax.grid(True, alpha=GRID_ALPHA)\n",
    "ax.legend(fontsize=FONT_LEGEND, loc=\"lower right\")\n",
    "fig.tight_layout()\n",
    "out = ALL_GT_JSON.parent / \"second_outermost_correct_hits_muon.pdf\"\n",
    "fig.savefig(out, bbox_inches=\"tight\", dpi=DPI)\n",
    "print(f\"Saved: {out}\")\n",
    "\n",
    "print(\"\")\n",
    "print(\"pT bin |  den  | num_any | num_exact | any   | exact\")\n",
    "for i in range(len(co2_pt_centers)):\n",
    "    if co2_den[i] == 0:\n",
    "        continue\n",
