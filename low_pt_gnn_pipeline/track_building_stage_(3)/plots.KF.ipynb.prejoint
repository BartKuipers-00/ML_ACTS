      "  0.425   1901    1796   0.985    0.998    1.013\n",
      "  0.435   1826    1745   0.990    0.999    1.010\n",
      "  0.445   1853    1776   0.987    0.998    1.011\n",
      "  0.455   1906    1814   0.989    1.000    1.011\n",
      "  0.465   1829    1736   0.986    1.000    1.014\n",
      "  0.475   1832    1757   0.989    0.999    1.010\n",
