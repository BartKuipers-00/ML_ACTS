   ],
   "source": [
    "# ── Mean hits per GT muon vs pT: new_build_1000 vs old_build1000-radial ───\n",
    "# Uses number_of_hits in particles_simulation.root. Top: <hits>(pT) overlaid\n",
    "# for both runs with std-error-of-mean error bars. Bottom: mean ratio new/old.\n",
    "\n",
    "import uproot\n",
    "import awkward as ak\n",
    "\n",
    "DIR_NUM = Path(\"/data/alice/bkuipers/acts/output_examples/old_build1000-radial\")\n",
    "DIR_DEN = Path(\"/data/alice/bkuipers/acts/output_examples/old_build1000-tangend\")\n",
    "LABEL_NUM = \"radial\"\n",
