      "  0.315   1850    1480   0.933    0.974    1.044\n",
      "  0.325   1966    1646   0.977    0.996    1.020\n",
      "  0.335   1842    1607   0.976    0.996    1.020\n",
      "  0.345   1861    1669   0.978    0.998    1.021\n",
      "  0.355   1892    1712   0.979    0.998    1.019\n",
      "  0.365   1830    1663   0.977    0.998    1.022\n",
