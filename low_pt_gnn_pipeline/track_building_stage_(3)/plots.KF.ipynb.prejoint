   "source": [
    "# ── Fake rate vs majority-truth pT — clean, axis 0.0–0.55 ────────────────\n",
    "# Same fake_rate_per_pt.json. For each reco CKF track we look up the truth\n",
    "# pT of its majorityParticleId (the truth particle contributing the most\n",
    "# hits) and bin by that. Tracks with majorityParticleId == 0 (no truth\n",
    "# majority at all) are skipped.\n",
    "#\n",
    "# A track is still \"fake\" by the same matchingdetails rule: matched=True\n",
    "# requires that majority contribute >= matchingFractionThreshold of the\n",
    "# hits.\n",
    "\n",
    "# (loaded already in the previous fake-rate cell as `_fr`)\n",
    "_fr_truth_tot = np.array(_fr[\"n_total_truth\"], dtype=float)\n",
    "_fr_truth_fk  = np.array(_fr[\"n_fake_truth\"],  dtype=float)\n",
    "_valid_t = _fr_truth_tot > 0\n",
    "_fr_truth = np.where(_valid_t,\n",
    "                     _fr_truth_fk / np.where(_valid_t, _fr_truth_tot, 1),\n",
    "                     np.nan)\n",
    "\n",
    "fig, ax = plt.subplots(figsize=FIGSIZE)\n",
    "half_w = 0.5 * (_fr_edges[1] - _fr_edges[0])\n",
    "ax.errorbar(_fr_centers[_valid_t], _fr_truth[_valid_t], xerr=half_w,\n",
    "            fmt=\"o\", color=\"black\",\n",
    "            markersize=3, capsize=CAPSIZE, capthick=1.2,\n",
    "            label=\"CKF\")\n",
    "\n",
    "ax.set_xlabel(r\"$p_T$ [GeV]\", fontsize=FONT_AXIS)\n",
    "ax.set_ylabel(\"Fake rate\", fontsize=FONT_AXIS)\n",
    "ax.tick_params(labelsize=FONT_TICK)\n",
    "ax.set_xlim(0.0, 0.55)\n",
    "ax.set_xticks(np.arange(0.1, 0.51, 0.1))\n",
    "ax.set_xticks(np.arange(0.05, 0.51, 0.1), minor=True)\n",
    "ax.set_ylim(0.0, 1.05)\n",
    "ax.grid(True, which=\"both\", alpha=GRID_ALPHA)\n",
    "ax.legend(fontsize=FONT_LEGEND, loc=\"upper left\")\n",
    "fig.tight_layout()\n",
    "\n",
    "out = DATA_DIR / \"fake_rate_vs_truth_pt.pdf\"\n",
    "fig.savefig(out, bbox_inches=\"tight\", dpi=DPI)\n",
    "print(f\"Saved: {out}\")\n",
    "plt.show()\n"
   ]
  },
