    "    bins = np.clip(np.searchsorted(pt_edges_local, pt, side=\"right\") - 1, 0, N_BINS - 1)\n",
    "    counts = np.bincount(bins, minlength=N_BINS).astype(float)\n",
    "    sums   = np.bincount(bins, weights=nh, minlength=N_BINS)\n",
    "    sums2  = np.bincount(bins, weights=nh * nh, minlength=N_BINS)\n",
    "    with np.errstate(divide=\"ignore\", invalid=\"ignore\"):\n",
    "        mean = np.where(counts > 0, sums / np.where(counts > 0, counts, 1), np.nan)\n",
    "        var  = np.where(counts > 1,\n",
    "                        (sums2 - counts * mean ** 2) / np.where(counts > 1, counts - 1, 1),\n",
    "                        np.nan)\n",
    "        sem  = np.where(counts > 0, np.sqrt(np.maximum(var, 0.0) / np.where(counts > 0, counts, 1)), np.nan)\n",
    "    return counts, mean, sem\n",
    "\n",
    "\n",
    "cnt_N, mean_N, sem_N = _hits_vs_pt(DIR_NUM, SPECIES_PDG)\n",
    "cnt_D, mean_D, sem_D = _hits_vs_pt(DIR_DEN, SPECIES_PDG)\n",
    "\n",
    "with np.errstate(divide=\"ignore\", invalid=\"ignore\"):\n",
    "    ratio = np.where(mean_D > 0, mean_N / np.where(mean_D > 0, mean_D, 1), np.nan)\n",
