   "source": [
    "# ── Number of proposed seeds vs fitted pT ───────────────────────────────────\n",
    "# Companion to the fake-rate plots above: how many seeds the triplet seeding\n",
    "# stage proposes as a function of the seed's own fitted (estimated) pT. Every\n",
    "# row in estimatedparams.root is one proposed seed, so we just histogram their\n",
    "# fitted pT. This is exactly the denominator (n_total) of the seeding fake-rate\n",
    "# plot, shown here as a raw count. Poisson (sqrt N) error bars.\n",
    "#   Binned on the seeding pT grid (_sfr[\"pt_edges\"], 0.1-0.5 GeV, 10 MeV bins).\n",
    "import uproot\n",
    "\n",
    "with uproot.open(DATA_DIR / \"estimatedparams.root\") as _f:\n",
    "    _seed_pt  = _f[\"estimatedparams\"][\"pt\"].array(library=\"np\")\n",
    "    _n_events = np.unique(_f[\"estimatedparams\"][\"event_nr\"].array(library=\"np\")).size\n",
    "\n",
    "_pt_edges   = np.array(_sfr[\"pt_edges\"],   float)\n",
    "_pt_centers = np.array(_sfr[\"pt_centers\"], float)\n",
    "_counts, _  = np.histogram(_seed_pt, bins=_pt_edges)\n",
    "_n_over     = int((_seed_pt > _pt_edges[-1]).sum())   # seeds above the top edge\n",
    "_n_total    = _seed_pt.size\n",
    "\n",
    "fig, ax_s = plt.subplots(figsize=FIGSIZE)\n",
    "ax_s.errorbar(_pt_centers, _counts,\n",
    "              xerr=np.diff(_pt_edges) / 2, yerr=np.sqrt(_counts),\n",
    "              fmt=METHOD_MARKER_P1[\"seed\"], color=\"#1f3a68\",\n",
    "              markersize=MS_P1, capsize=CAPSIZE, capthick=1,\n",
    "              label=\"Triplet seeding\")\n",
    "\n",
    "ax_s.set_xlabel(r\"fitted $p_T$ [GeV]\", fontsize=FONT_AXIS)\n",
    "ax_s.set_ylabel(\"Number of proposed seeds\", fontsize=FONT_AXIS)\n",
    "ax_s.set_xlim(0.0, 0.55)\n",
    "ax_s.set_xticks(np.arange(0.1, 0.51, 0.1))\n",
    "ax_s.set_xticks(np.arange(0.05, 0.51, 0.1), minor=True)\n",
    "ax_s.set_ylim(bottom=0)\n",
    "ax_s.tick_params(labelsize=FONT_TICK - 1)\n",
    "ax_s.grid(True, which=\"both\", alpha=GRID_ALPHA)\n",
    "ax_s.legend(fontsize=FONT_LEGEND - 1, loc=\"upper right\", frameon=False)\n",
    "\n",
    "# Annotation block: upper-left (curve falls off to the right).\n",
    "ANNO_ANCHOR = (0.04, 0.96)\n",
    "_anno_box = dict(facecolor=\"white\", edgecolor=\"none\", alpha=0.85, pad=2)\n",
    "_ax, _ay = ANNO_ANCHOR\n",
    "_anno_kw = dict(transform=ax_s.transAxes, va=\"top\", ha=\"left\", bbox=_anno_box)\n",
    "ax_s.text(_ax, _ay,                    r\"$\\mathbf{Generic \\ Detector}$ Simulation\",\n",
    "          fontsize=FONT_AXIS - 3, **_anno_kw)\n",
    "ax_s.text(_ax, _ay -  ANNO_LINE_DY,    \"FATRAS, 300 particles / event\",\n",
    "          fontsize=FONT_AXIS - 5, style=\"italic\", **_anno_kw)\n",
    "ax_s.text(_ax, _ay - 2 * ANNO_LINE_DY, f\"{_n_total:,} seeds / {_n_events} events\",\n",
    "          fontsize=FONT_AXIS - 5, style=\"italic\", **_anno_kw)\n",
    "\n",
    "fig.tight_layout()\n",
    "out = DATA_DIR / \"n_seeds_vs_fitted_pt_replot.pdf\"\n",
    "fig.savefig(out, bbox_inches=\"tight\", dpi=DPI)\n",
    "print(f\"Saved: {out}\")\n",
    "print(f\"{_n_total:,} seeds total over {_n_events} events; \"\n",
    "      f\"{_n_over:,} above {_pt_edges[-1]:.2f} GeV \"\n",
    "      f\"({100 * _n_over / _n_total:.1f}% overflow, not shown).\")\n",
    "plt.show()\n"
   ]
  },
