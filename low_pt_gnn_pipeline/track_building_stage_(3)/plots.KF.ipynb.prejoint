     "output_type": "display_data"
    }
   ],
   "source": [
    "# ── Fake rate vs pT: Triplet seeding + CKF  vs  SegmentGNN  vs  helix ─────────\n",
    "# Three separate curves on the reference-figure style:\n",
    "#   * Triplet seeding + CKF — pooled fake rate from fake_rate_per_pt.json\n",
    "#       (n_fake_nocut / n_total_nocut), rebinned to the SegmentGNN pT grid.\n",
    "#   * SegmentGNN  and  helix — per-track fake rate of each builder, read from\n",
    "#       its matching_df_*.csv (same per-track definition as plots.ipynb cell 36).\n",
    "# Fully self-contained: imports + style + paths defined here, so it runs on its\n",
    "# own without executing the earlier setup cells.\n",
    "import csv, json\n",
    "from pathlib import Path\n",
    "from collections import defaultdict\n",
    "import numpy as np\n",
    "import scipy.stats\n",
    "import matplotlib.pyplot as plt\n",
    "from matplotlib.ticker import MultipleLocator\n",
    "\n",
    "# ── Style (falls back to defaults if the notebook setup cell wasn't run) ──────\n",
    "FIGSIZE      = globals().get(\"FIGSIZE\", (7, 5))\n",
    "FONT_AXIS    = globals().get(\"FONT_AXIS\", 18)\n",
    "FONT_TICK    = globals().get(\"FONT_TICK\", 14)\n",
    "FONT_LEGEND  = globals().get(\"FONT_LEGEND\", 14)\n",
    "CAPSIZE      = globals().get(\"CAPSIZE\", 3)\n",
    "GRID_ALPHA   = globals().get(\"GRID_ALPHA\", 0.3)\n",
    "MS_P1        = globals().get(\"MS_P1\", 4)\n",
    "ANNO_LINE_DY = globals().get(\"ANNO_LINE_DY\", 0.07)\n",
    "DPI          = globals().get(\"DPI\", 150)\n",
    "# CKF JSON dir: reuse the notebook's DATA_DIR if defined, else default to the\n",
    "# 300-mixed helix sample used for the reference figure.\n",
    "CKF_DIR      = globals().get(\"DATA_DIR\",\n",
    "    Path(\"/data/alice/bkuipers/acts/output_examples/CKF_300_mixed_helix_1000_events/clean\"))\n",
    "\n",
    "# ── pT grid: the SegmentGNN efficiency grid (29 bins, 0.1-0.5 GeV) ───────────\n",
    "_FR_DATA_ROOT = Path(\"/data/alice/bkuipers/low_pt_gnn_pipeline/data_300_mixed\")\n",
    "_GEFF = _FR_DATA_ROOT / \"visuals/track_metrics/testset_SegmentGNN/efficiency_vs_pt_testset_SegmentGNN.json\"\n",
    "_egnn = next(s for s in json.load(open(_GEFF))[\"series\"] if s.get(\"label\", \"\").startswith(\"Electron\"))\n",
    "GX  = np.array(_egnn[\"x\"], float)\n",
    "GXE = np.array(_egnn[\"xerr\"], float)\n",
    "G_EDGES = np.concatenate([GX - GXE, [GX[-1] + GXE[-1]]])\n",
    "\n",
    "def _fr_cp_err(passed, total, level=0.68):\n",
    "    \"\"\"Clopper-Pearson 68% CL band as (lo, hi) offsets from the central value.\"\"\"\n",
    "    a = (1 - level) / 2\n",
    "    passed = np.asarray(passed, float); total = np.asarray(total, float)\n",
    "    lo = np.where(passed > 0, scipy.stats.beta.ppf(a, passed, total - passed + 1), 0.0)\n",
    "    hi = np.where(passed < total, scipy.stats.beta.ppf(1 - a, passed + 1, total - passed), 1.0)\n",
    "    eff = np.where(total > 0, passed / np.where(total > 0, total, 1), np.nan)\n",
    "    return np.maximum(0, eff - lo), np.maximum(0, hi - eff)\n",
    "\n",
    "def _gnn_fake_rate(csv_path):\n",
    "    \"\"\"Per-track fake rate per pT bin from a matching_df CSV (see plots.ipynb cell 36).\n",
    "    Returns (fake_rate, lo_err, hi_err, valid_mask, overall_fake_rate).\"\"\"\n",
    "    tracks = defaultdict(list)\n",
    "    with open(csv_path) as f:\n",
    "        for row in csv.DictReader(f):\n",
    "            if row[\"track_id\"] == \"-1\":          # per-event noise bucket, not a real track\n",
    "                continue\n",
    "            if row[\"is_matchable\"].lower() not in (\"true\", \"1\"):\n",
    "                continue   # >=7-hit / fiducial cut (is_matchable), matches plots.ipynb fake-rate def\n",
    "            tracks[(row[\"event_id\"], row[\"track_id\"])].append(row)\n",
    "    n_tot = np.zeros(len(GX)); n_fake = np.zeros(len(GX))\n",
    "    for rows in tracks.values():\n",
    "        maj = max(rows, key=lambda r: int(r[\"n_shared\"]))   # majority particle\n",
    "        try:\n",
    "            pt = float(maj[\"pt\"])\n",
    "        except ValueError:\n",
    "            continue\n",
    "        if pt < G_EDGES[0] or pt >= G_EDGES[-1]:\n",
    "            continue\n",
    "        b = int(np.searchsorted(G_EDGES, pt, side=\"right\") - 1)\n",
    "        if not (0 <= b < len(GX)):\n",
    "            continue\n",
    "        is_fake = not any(r[\"is_matched\"].lower() in (\"true\", \"1\") for r in rows)\n",
    "        n_tot[b] += 1\n",
    "        if is_fake:\n",
    "            n_fake[b] += 1\n",
    "    fr = np.where(n_tot > 0, n_fake / np.where(n_tot > 0, n_tot, 1), np.nan)\n",
    "    lo, hi = _fr_cp_err(n_fake, n_tot)\n",
    "    overall = n_fake.sum() / max(n_tot.sum(), 1)\n",
    "    return fr, lo, hi, n_tot > 0, overall\n",
    "\n",
    "_EVAL = _FR_DATA_ROOT / \"track_evaluation\"\n",
    "sgnn_fr,  sgnn_lo,  sgnn_hi,  sgnn_valid,  sgnn_overall  = _gnn_fake_rate(\n",
    "    _EVAL / \"testset_SegmentGNN_minlen7/matching_df_testset_SegmentGNN_minlen7.csv\")\n",
    "helix_fr, helix_lo, helix_hi, helix_valid, helix_overall = _gnn_fake_rate(\n",
    "    _EVAL / \"testset_helix_minlen7/matching_df_testset_helix_minlen7.csv\")\n",
    "\n",
    "# ── Triplet seeding + CKF: pooled fake rate, rebinned to the GNN grid ─────────\n",
    "with open(CKF_DIR / \"fake_rate_per_pt.json\") as _f:\n",
    "    _ckf = json.load(_f)\n",
    "def _fr_rebin(num, den, centers):\n",
    "    n = np.zeros(len(GX)); d = np.zeros(len(GX))\n",
    "    for i, c in enumerate(centers):\n",
    "        b = int(np.searchsorted(G_EDGES, c, side=\"right\") - 1)\n",
    "        if 0 <= b < len(GX):\n",
    "            n[b] += num[i]; d[b] += den[i]\n",
    "    return n, d\n",
    "ckf_fake, ckf_tot = _fr_rebin(np.array(_ckf[\"n_fake_nocut\"],  float),\n",
    "                              np.array(_ckf[\"n_total_nocut\"], float),\n",
    "                              np.array(_ckf[\"pt_centers\"],    float))\n",
    "ckf_fr = np.where(ckf_tot > 0, ckf_fake / np.where(ckf_tot > 0, ckf_tot, 1), np.nan)\n",
    "ckf_lo, ckf_hi = _fr_cp_err(ckf_fake, ckf_tot)\n",
    "ckf_valid = ckf_tot > 0\n",
    "ckf_overall = ckf_fake.sum() / max(ckf_tot.sum(), 1)\n",
    "\n",
    "# ── Plot (style matches the Triplet-seeding reference figure) ─────────────────\n",
    "fig, ax_p = plt.subplots(figsize=FIGSIZE)\n",
    "\n",
    "ax_p.errorbar(GX[ckf_valid], ckf_fr[ckf_valid],\n",
    "              xerr=GXE[ckf_valid], yerr=[ckf_lo[ckf_valid], ckf_hi[ckf_valid]],\n",
    "              fmt=\"s\", color=\"#c0392b\", markersize=MS_P1, capsize=CAPSIZE, capthick=1,\n",
    "              label=\"Triplet seeding + CKF\")\n",
    "ax_p.errorbar(GX[sgnn_valid], sgnn_fr[sgnn_valid],\n",
    "              xerr=GXE[sgnn_valid], yerr=[sgnn_lo[sgnn_valid], sgnn_hi[sgnn_valid]],\n",
    "              fmt=\"^\", color=\"#1f3a68\", markersize=MS_P1, capsize=CAPSIZE, capthick=1,\n",
    "              label=\"GNN + SegmentGNN\")\n",
    "ax_p.errorbar(GX[helix_valid], helix_fr[helix_valid],\n",
    "              xerr=GXE[helix_valid], yerr=[helix_lo[helix_valid], helix_hi[helix_valid]],\n",
    "              fmt=\"o\", color=\"#5c3317\", markersize=MS_P1, capsize=CAPSIZE, capthick=1,\n",
    "              label=\"GNN + helix matching\")\n",
    "\n",
    "ax_p.set_xlabel(r\"$p_T$ [GeV]\", fontsize=FONT_AXIS)\n",
    "ax_p.set_ylabel(\"Fake rate\", fontsize=FONT_AXIS)\n",
    "\n",
    "# auto-fit x to the data range + 8% padding (same as the SegmentGNN plots)\n",
    "_lo, _hi = float(G_EDGES[0]), float(G_EDGES[-1])\n",
    "_pad = max((_hi - _lo) * 0.08, 0.02)\n",
    "ax_p.set_xlim(_lo - _pad, _hi + _pad)\n",
    "\n",
    "ax_p.xaxis.set_minor_locator(MultipleLocator(0.05))   # faint minor grid every 0.05\n",
    "ax_p.set_ylim(0.0, 1.05)\n",
    "ax_p.tick_params(labelsize=FONT_TICK - 1)\n",
    "ax_p.grid(True, alpha=GRID_ALPHA)\n",
    "ax_p.grid(True, which=\"minor\", axis=\"x\", alpha=GRID_ALPHA * 0.5)\n",
    "ax_p.legend(fontsize=FONT_LEGEND - 1, loc=\"upper right\", frameon=False)\n",
    "\n",
    "# # Annotation block (lower-left), same as the reference figure.\n",
    "# _anno = (0.04, 0.22)\n",
    "# _anno_kw = dict(transform=ax_p.transAxes, va=\"top\", ha=\"left\",\n",
    "#                 bbox=dict(facecolor=\"white\", edgecolor=\"none\", alpha=0.85, pad=2))\n",
    "# ax_p.text(_anno[0], _anno[1],                    r\"$\\mathbf{Generic \\ Detector}$ Simulation\",\n",
    "#           fontsize=FONT_AXIS - 3, **_anno_kw)\n",
    "# ax_p.text(_anno[0], _anno[1] -     ANNO_LINE_DY, \"FATRAS, 300 particles / event\",\n",
    "#           fontsize=FONT_AXIS - 5, style=\"italic\", **_anno_kw)\n",
    "# ax_p.text(_anno[0], _anno[1] - 2 * ANNO_LINE_DY, r\"$|\\eta| < 0.15$, track-averaged\",\n",
    "#           fontsize=FONT_AXIS - 5, style=\"italic\", **_anno_kw)\n",
    "\n",
    "fig.tight_layout()\n",
    "out = _FR_DATA_ROOT / \"visuals/track_metrics/fake_rate_ckf_vs_gnn_vs_pt.pdf\"\n",
    "fig.savefig(out, bbox_inches=\"tight\", dpi=DPI)\n",
    "print(f\"Saved: {out}\")\n",
    "print(f\"  overall  CKF: {ckf_overall:.3f}   \"\n",
    "      f\"SegmentGNN: {sgnn_overall:.3f}   helix: {helix_overall:.3f}\")\n",
    "plt.show()\n"
   ]
  },
  {
   "cell_type": "markdown",
   "id": "eff-seeding-ckf-gnn-md",
   "metadata": {},
   "source": [
    "## Efficiency vs $p_T$: Triplet seeding, Triplet seeding + CKF, SegmentGNN, helix\n",
    "\n",
    "Companion to the fake-rate figure. Tracking efficiency for the four approaches, all **species-averaged** (unweighted mean of the per-species efficiencies, so the curve is not pulled by changing species composition across $p_T$ bins) on the common SegmentGNN $p_T$ grid.\n",
    "\n",
    "- **Triplet seeding** — matched fraction at the seeding stage (`seeding_eff_per_particle.json`).\n",
    "- **Triplet seeding + CKF** — full CKF pipeline efficiency (`eff_per_particle.json`).\n",
    "- **GNN + SegmentGNN** and **GNN + helix matching** — per-species efficiency from each builder's `efficiency_vs_pt_*.json`.\n",
    "\n",
    "Efficiency is intrinsically a per-truth-particle quantity, so all four curves are binned by truth $p_T$. Error bars are Clopper-Pearson 68% CL, combined across species in quadrature / $N_\\mathrm{species}$."
   ]
  },
  {
   "cell_type": "code",
   "execution_count": null,
   "id": "eff-seeding-ckf-gnn-code",
   "metadata": {},
   "outputs": [
    {
     "name": "stdout",
     "output_type": "stream",
     "text": [
      "Saved: /data/alice/bkuipers/low_pt_gnn_pipeline/data_300_mixed/visuals/track_metrics/efficiency_seeding_ckf_gnn_vs_pt.pdf\n",
      "  mean eff (seeding): 0.857\n",
      "  mean eff (CKF): 0.564\n",
      "  mean eff (SegmentGNN): 0.895\n",
      "  mean eff (helix): 0.795\n"
     ]
    },
    {
     "data": {
      "image/png": "",
      "text/plain": [
       "<Figure size 700x500 with 1 Axes>"
