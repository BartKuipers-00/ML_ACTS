   "source": [
    "# ── >=1 correct-hit fraction on outermost and 2nd-outermost GT layers ─────\n",
    "# One plot, two curves — same metric (num_any / den, Muon), different layers.\n",
    "# Reuses _co, _co2 loaded above.\n",
    "\n",
    "fig, ax = plt.subplots(figsize=FIGSIZE)\n",
    "half_w = 0.5 * (co_pt_edges[1] - co_pt_edges[0])\n",
    "\n",
    "valid1 = co_den > 0\n",
    "ax.errorbar(co_pt_centers[valid1], co_any[valid1],\n",
    "            xerr=half_w, yerr=co_any_err[valid1],\n",
    "            fmt=\"o\", color=\"#1f77b4\", markersize=3,\n",
    "            capsize=CAPSIZE, capthick=1.2,\n",
    "            label=r\"Outermost-r GT layer\")\n",
    "\n",
    "valid2 = co2_den > 0\n",
    "ax.errorbar(co2_pt_centers[valid2], co2_any[valid2],\n",
    "            xerr=half_w, yerr=co2_any_err[valid2],\n",
    "            fmt=\"s\", color=\"#d62728\", markersize=3,\n",
    "            capsize=CAPSIZE, capthick=1.2,\n",
    "            label=r\"2nd-outermost-r GT layer\")\n",
    "\n",
    "# Theoretical pT thresholds per layer (pT = 0.5 * 0.3 * B * R).\n",
    "for _i, (lay, thr) in enumerate(dip_layers):\n",
    "    ax.axvline(thr, color=\"black\", linestyle=\"--\", linewidth=1.0, alpha=0.6,\n",
    "               zorder=0,\n",
    "               label=\"Theoretical layer-reach threshold\" if _i == 0 else None)\n",
    "\n",
    "ax.set_xlabel(r\"$p_T$ [GeV]\", fontsize=FONT_AXIS)\n",
    "ax.set_ylabel(r\"Muon fraction with $\\geq$1 correct measurement\",\n",
    "              fontsize=FONT_AXIS)\n",
    "ax.tick_params(labelsize=FONT_TICK)\n",
    "ax.set_xlim(0.05, 0.52)\n",
    "ax.set_ylim(0.0, 1.05)\n",
    "ax.grid(True, alpha=GRID_ALPHA)\n",
    "ax.legend(fontsize=FONT_LEGEND - 1, loc=\"lower right\", frameon=False)\n",
    "fig.tight_layout()\n",
    "out = ALL_GT_JSON.parent / \"outer_vs_2nd_outer_correct_hits_muon.pdf\"\n",
    "fig.savefig(out, bbox_inches=\"tight\", dpi=DPI)\n",
    "print(f\"Saved: {out}\")\n",
    "plt.show()\n"
   ]
  },
