   ],
   "source": [
    "# ── Fake CKF tracks: purity to the best (majority) truth particle ────────\n",
    "# For every FAKE CKF track (no matchingdetails row with matched=True), take\n",
    "# its majority truth particle (most matched hits) and histogram the track\n",
    "# purity = nMatchedHitsOnTrack / nTrackMeasurements (fraction of the track's\n",
    "# hits coming from that particle). Data: ckf_fake_purity_completeness.json\n",
    "# (helpers/ckf_fake_purity_completeness.C).\n",
    "\n",
    "with open(DATA_DIR / \"ckf_fake_purity_completeness.json\") as _f:\n",
    "    _fp = json.load(_f)\n",
    "\n",
    "_edges   = np.array(_fp[\"edges\"])\n",
    "_counts  = np.array(_fp[\"purity_counts\"], float)\n",
    "\n",
    "# Rebin to slightly wider bins (merge REBIN fine bins). With REBIN=2 the bin\n",
    "# width becomes 0.04 and 0.5 sits at a bin CENTRE instead of straddling an\n",
    "# edge, removing the comb artifact around 1/2. Then normalise so the bars give\n",
    "# the fraction of all fakes in each purity bin (sum = 1).\n",
    "REBIN    = 2\n",
    "_edges   = _edges[::REBIN]\n",
    "_counts  = _counts.reshape(-1, REBIN).sum(axis=1)\n",
    "_counts  = _counts / _counts.sum()\n",
    "_centers = 0.5 * (_edges[:-1] + _edges[1:])\n",
    "_width   = _edges[1] - _edges[0]\n",
    "\n",
    "fig, ax = plt.subplots(figsize=FIGSIZE)\n",
    "ax.bar(_centers, _counts, width=_width, color=\"#1f3a68\",\n",
    "       edgecolor=\"white\", linewidth=0.3)\n",
    "ax.set_xlabel(\"Purity to best-matched truth particle\", fontsize=FONT_AXIS)\n",
    "ax.set_ylabel(\"Fraction of fake CKF tracks\", fontsize=FONT_AXIS)\n",
    "ax.set_xlim(0.0, 1.0)\n",
    "ax.tick_params(labelsize=FONT_TICK)\n",
    "ax.grid(True, which=\"both\", axis=\"y\", alpha=GRID_ALPHA)\n",
    "ax.text(0.03, 0.95, f\"{int(_fp['n_fake']):,} fake CKF tracks\",\n",
    "        transform=ax.transAxes, va=\"top\", ha=\"left\", fontsize=FONT_LEGEND - 1)\n",
    "fig.tight_layout()\n",
    "out = DATA_DIR / \"ckf_fake_purity_hist.pdf\"\n",
    "fig.savefig(out, bbox_inches=\"tight\", dpi=DPI)\n",
    "print(f\"Saved: {out}\")\n",
    "plt.show()"
   ]
  },
