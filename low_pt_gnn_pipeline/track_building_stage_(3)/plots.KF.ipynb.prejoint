   "source": [
    "# ── Muon efficiency: original vs \"drop almost-made-it\" filter (+ ratio panel)\n",
    "# Drops only one specific failure cohort: GT muons whose best KF attempt\n",
    "# anchored a Measurement on the 2nd-outermost-r truth layer but failed to\n",
    "# visit the outermost-r truth layer in any state. Everything else stays in\n",
    "# the denominator — including muons whose KF never reached the 2nd-outer\n",
    "# region at all (those are not the failure mode we're isolating here).\n",
    "\n",
    "_da = _allgt[\"clean_eff_drop_almost_made_it\"]\n",
    "da_pt_centers = np.array(_da[\"pt_centers\"])\n",
    "da_pt_edges   = np.array(_da[\"pt_edges\"])\n",
    "da_num = np.array(_da[\"num\"][\"Muon\"], dtype=float)\n",
    "da_den = np.array(_da[\"den\"][\"Muon\"], dtype=float)\n",
    "da_eff = np.where(da_den > 0,\n",
    "                  da_num / np.where(da_den > 0, da_den, 1), np.nan)\n",
    "\n",
    "assert np.allclose(da_pt_centers, eff_pt_centers), \\\n",
    "    \"clean_eff_drop_almost_made_it pT axis does not match eff_per_particle.json\"\n",
    "\n",
    "with np.errstate(divide=\"ignore\", invalid=\"ignore\"):\n",
    "    da_err = np.where(da_den > 0,\n",
    "                      np.sqrt(np.maximum(da_eff * (1 - da_eff), 0.0) /\n",
    "                              np.where(da_den > 0, da_den, 1)),\n",
    "                      np.nan)\n",
    "    ratio_da = np.where(mu_eff > 0,\n",
    "                        da_eff / np.where(mu_eff > 0, mu_eff, 1), np.nan)\n",
    "    rel_da = np.sqrt(np.where(da_eff > 0,\n",
    "                              (da_err / np.where(da_eff > 0, da_eff, 1)) ** 2, np.nan)\n",
    "                   + np.where(mu_eff > 0,\n",
    "                              (mu_err / np.where(mu_eff > 0, mu_eff, 1)) ** 2, np.nan))\n",
    "    ratio_da_err = ratio_da * rel_da\n",
    "\n",
    "fig, axes = plt.subplots(2, 1, figsize=(FIGSIZE[0], FIGSIZE[1] * 1.4),\n",
    "                         sharex=True, gridspec_kw={\"height_ratios\": [2, 1]})\n",
    "half_w = 0.5 * (eff_pt_edges[1] - eff_pt_edges[0])\n",
    "\n",
    "# Top panel: efficiency overlays.\n",
    "ax = axes[0]\n",
    "valid = mu_den > 0\n",
    "ax.errorbar(eff_pt_centers[valid], mu_eff[valid],\n",
    "            xerr=half_w, yerr=mu_err[valid],\n",
    "            fmt=SPECIES_MARKER[\"Muon\"], color=SPECIES_COLOR[\"Muon\"],\n",
    "            markersize=3, capsize=CAPSIZE, capthick=1.2,\n",
    "            label=\"Muon (all GT)\")\n",
    "\n",
    "valid_d = da_den > 0\n",
    "ax.errorbar(da_pt_centers[valid_d], da_eff[valid_d],\n",
    "            xerr=half_w, yerr=da_err[valid_d],\n",
    "            fmt=\"o\", color=\"#9467bd\", markersize=3,\n",
    "            capsize=CAPSIZE, capthick=1.2,\n",
    "            label=\"Muon (drop: KF measured 2nd-outer but missed outer)\")\n",
    "\n",
    "overlay_dips(ax, label=\"staircase dip (muon-derived)\")\n",
    "for lay, thr in dip_layers:\n",
    "    ax.axvline(thr, color=\"grey\", linestyle=\":\", linewidth=1.0, alpha=0.5)\n",
    "\n",
    "ax.set_ylabel(\"Efficiency\", fontsize=FONT_AXIS)\n",
    "ax.set_title(\"Muon efficiency vs $p_T$ — drop almost-made-it filter\",\n",
    "             fontsize=12)\n",
    "ax.tick_params(labelsize=FONT_TICK)\n",
    "ax.set_ylim(0.0, 1.05)\n",
    "ax.grid(True, alpha=GRID_ALPHA)\n",
    "ax.legend(fontsize=FONT_LEGEND, loc=\"lower right\")\n",
    "\n",
    "# Bottom panel: filtered / all-GT ratio.\n",
    "ax = axes[1]\n",
    "ax.errorbar(da_pt_centers, ratio_da, xerr=half_w, yerr=ratio_da_err,\n",
    "            fmt=\"o\", color=\"black\", markersize=3,\n",
    "            capsize=CAPSIZE, capthick=1.2)\n",
    "ax.axhline(1.0, color=\"grey\", linestyle=\"--\", linewidth=1.0, alpha=0.7)\n",
    "overlay_dips(ax)\n",
    "for lay, thr in dip_layers:\n",
    "    ax.axvline(thr, color=\"grey\", linestyle=\":\", linewidth=1.0, alpha=0.5)\n",
    "\n",
    "ax.set_xlabel(r\"$p_T$ [GeV]\", fontsize=FONT_AXIS)\n",
    "ax.set_ylabel(r\"$\\epsilon_\\mathrm{drop\\,almost}\\,/\\,\\epsilon_\\mathrm{all\\,GT}$\",\n",
    "              fontsize=FONT_AXIS - 4)\n",
    "ax.tick_params(labelsize=FONT_TICK)\n",
    "ax.set_xlim(eff_pt_edges[0], eff_pt_edges[-1])\n",
    "ax.grid(True, alpha=GRID_ALPHA)\n",
    "\n",
    "fig.tight_layout()\n",
    "out = ALL_GT_JSON.parent / \"eff_muon_drop_almost_made_it_replot.pdf\"\n",
    "fig.savefig(out, bbox_inches=\"tight\", dpi=DPI)\n",
    "print(f\"Saved: {out}\")\n",
    "\n",
    "print(\"\")\n",
    "print(\"pT bin | d_orig | d_keep | eff_orig | eff_keep | ratio\")\n",
    "for i in range(len(da_pt_centers)):\n",
    "    if mu_den[i] == 0:\n",
    "        continue\n",
    "    eo = mu_eff[i]\n",
    "    ek = da_eff[i]   if da_den[i] > 0 else float(\"nan\")\n",
    "    r  = ratio_da[i] if (da_den[i] > 0 and mu_eff[i] > 0) else float(\"nan\")\n",
    "    print(f\"  {da_pt_centers[i]:.3f}  {int(mu_den[i]):5d}   \"\n",
    "          f\"{int(da_den[i]):5d}   {eo:.3f}    {ek:.3f}    {r:.3f}\")\n",
    "plt.show()\n"
   ]
