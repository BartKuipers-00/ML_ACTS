   "source": [
    "# ── CKF fake rate vs majority-truth pT — per species ─────────────────────\n",
    "# Per-species companion to the per-species efficiency plot. Counts are\n",
    "# rebinned onto the SAME GNN grid (gnn_x / gnn_xerr) the efficiency plots\n",
    "# use, via _rebin_to_gnn, so the bin count/edges are identical.\n",
    "# For each reco CKF track we take its majority-truth particle (recomputed\n",
    "# from trackstates particle_ids), bin by that particle's truth pT, and split\n",
    "# by species. A track is \"fake\" if the majority contributes\n",
    "# < matchingFractionThreshold of its hits; tracks with no truth majority are\n",
    "# excluded. Data: fake_rate_per_pt.json n_*_truth_species.\n",
    "# Uncertainty: Clopper-Pearson 68% on the fake fraction, _kf_cp_err(fake,total).\n",
    "\n",
    "# Self-contained species styling (cell 38 overwrites the global SPECIES_COLOR\n",
    "# with a Muon/Pion-only dict, so we keep a local copy here).\n",
    "_SP_COLOR  = {\"Electron\": \"#2ca02c\", \"Muon\": \"#1f77b4\",\n",
    "              \"Pion\": \"#ff7f0e\", \"Proton\": \"#d62728\"}\n",
    "_SP_MARKER = {\"Electron\": \"^\", \"Muon\": \"o\", \"Pion\": \"s\", \"Proton\": \"D\"}\n",
    "\n",
    "with open(DATA_DIR / \"fake_rate_per_pt.json\") as _f:\n",
    "    _fr = json.load(_f)\n",
    "_fr_c = np.array(_fr[\"pt_centers\"], float)\n",
    "\n",
    "fig, ax_p = plt.subplots(figsize=FIGSIZE)\n",
    "\n",
    "for sp in [\"Electron\", \"Muon\", \"Pion\", \"Proton\"]:\n",
    "    n, d = _rebin_to_gnn(np.array(_fr[\"n_fake_truth_species\"][sp],  float),\n",
    "                         np.array(_fr[\"n_total_truth_species\"][sp], float),\n",
    "                         _fr_c)\n",
    "    val = d > 0\n",
    "    fr  = np.where(val, n / np.where(val, d, 1), np.nan)\n",
    "    lo, hi = _kf_cp_err(n, d)\n",
    "    ax_p.errorbar(gnn_x[val], fr[val],\n",
    "                  xerr=gnn_xerr[val], yerr=[lo[val], hi[val]],\n",
    "                  fmt=_SP_MARKER[sp], color=_SP_COLOR[sp],\n",
    "                  markersize=MS_P1, capsize=CAPSIZE, capthick=1,\n",
    "                  label=sp)\n",
    "\n",
    "ax_p.set_xlabel(r\"$p_T$ [GeV]\", fontsize=FONT_AXIS)\n",
    "ax_p.set_ylabel(\"CKF fake rate\", fontsize=FONT_AXIS)\n",
    "ax_p.set_xlim(0.0, 0.55)\n",
    "ax_p.set_xticks(np.arange(0.1, 0.51, 0.1))\n",
    "ax_p.set_xticks(np.arange(0.05, 0.51, 0.1), minor=True)\n",
    "ax_p.set_ylim(0.0, 1.05)\n",
    "ax_p.tick_params(labelsize=FONT_TICK - 1)\n",
    "ax_p.grid(True, which=\"both\", alpha=GRID_ALPHA)\n",
    "ax_p.legend(fontsize=FONT_LEGEND - 1, loc=\"upper right\", frameon=False)\n",
    "\n",
    "fig.tight_layout()\n",
    "out = DATA_DIR / \"fake_rate_ckf_per_species_replot.pdf\"\n",
    "fig.savefig(out, bbox_inches=\"tight\", dpi=DPI)\n",
    "print(f\"Saved: {out}\")\n",
    "plt.show()\n"
   ]
  },
