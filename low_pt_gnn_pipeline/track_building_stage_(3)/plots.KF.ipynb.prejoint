   "source": [
    "# ── Fake CKF tracks: number of hits (measurements) per track ─────────────\n",
    "# For every FAKE CKF track (no matchingdetails row with matched=True), the\n",
    "# number of measurements on the track (nTrackMeasurements). Bars give the\n",
    "# fraction of all fake tracks with that hit count (sum = 1). x-axis = hits on\n",
    "# the fake track, y-axis = fraction of fakes.\n",
    "# Data: ckf_fake_purity_completeness.json (nhits_counts, index = hit count;\n",
    "# anything > nhits_max is folded into the last bin).\n",
    "\n",
    "with open(DATA_DIR / \"ckf_fake_purity_completeness.json\") as _f:\n",
    "    _fp = json.load(_f)\n",
    "\n",
    "_nh_counts = np.array(_fp[\"nhits_counts\"], float)\n",
    "_nh_x      = np.arange(len(_nh_counts))           # hit count per bin index\n",
    "_nh_frac   = _nh_counts / _nh_counts.sum()        # fraction of all fakes\n",
    "\n",
    "# Trim to the populated range so the bars aren't squashed by empty high bins.\n",
    "_nz = np.nonzero(_nh_counts)[0]\n",
    "_lo, _hi = _nz.min(), _nz.max()\n",
    "_xsel  = _nh_x[_lo:_hi + 1]\n",
    "_ysel  = _nh_frac[_lo:_hi + 1]\n",
    "\n",
    "fig, ax = plt.subplots(figsize=FIGSIZE)\n",
    "ax.bar(_xsel, _ysel, width=0.9, color=\"#1f3a68\",\n",
    "       edgecolor=\"white\", linewidth=0.3)\n",
    "ax.set_xlabel(\"Hits on fake CKF track\", fontsize=FONT_AXIS)\n",
    "ax.set_ylabel(\"Fraction of fake CKF tracks\", fontsize=FONT_AXIS)\n",
    "ax.set_xticks(_xsel[::1] if len(_xsel) <= 20 else _xsel[::2])\n",
    "ax.tick_params(labelsize=FONT_TICK)\n",
    "ax.grid(True, which=\"both\", axis=\"y\", alpha=GRID_ALPHA)\n",
    "ax.text(0.97, 0.95,\n",
    "        f\"{int(_fp['n_fake']):,} fake CKF tracks\\nmean {np.average(_nh_x, weights=_nh_counts):.1f} hits\",\n",
    "        transform=ax.transAxes, va=\"top\", ha=\"right\", fontsize=FONT_LEGEND - 1)\n",
    "fig.tight_layout()\n",
    "out = DATA_DIR / \"ckf_fake_nhits_hist.pdf\"\n",
    "fig.savefig(out, bbox_inches=\"tight\", dpi=DPI)\n",
    "print(f\"Saved: {out}\")\n",
    "plt.show()\n"
   ]
  },
