   "source": [
    "# ── Muon efficiency: original vs V13/V17-clean filter (+ ratio panel) ───────\n",
    "# Top: efficiency vs pT, all GT muons vs muons whose best KF attempt has 0\n",
    "# misses in the filter volumes. Bottom: clean/original ratio per bin.\n",
    "# Error treatment: binomial (Wald) per efficiency, propagated as if the two\n",
    "# samples were independent for the ratio. Clean is actually a subset of the\n",
    "# original, so the propagated band is a conservative overestimate.\n",
    "\n",
    "ALL_GT_JSON = DATA_DIR / \"attribute_holes_per_layer_all_gt.json\"\n",
    "with open(ALL_GT_JSON) as f:\n",
    "    _allgt = json.load(f)\n",
    "_ce = _allgt[\"clean_eff\"]\n",
    "\n",
    "cln_pt_centers = np.array(_ce[\"pt_centers\"])\n",
    "cln_pt_edges   = np.array(_ce[\"pt_edges\"])\n",
    "cln_num = np.array(_ce[\"num\"][\"Muon\"], dtype=float)\n",
    "cln_den = np.array(_ce[\"den\"][\"Muon\"], dtype=float)\n",
    "cln_eff = np.where(cln_den > 0,\n",
    "                   cln_num / np.where(cln_den > 0, cln_den, 1), np.nan)\n",
    "\n",
    "assert np.allclose(cln_pt_centers, eff_pt_centers), \\\n",
    "    \"clean_eff pT axis does not match eff_per_particle.json\"\n",
    "\n",
    "mu_den = den_by_species[\"Muon\"].astype(float)\n",
    "with np.errstate(divide=\"ignore\", invalid=\"ignore\"):\n",
    "    mu_err = np.where(mu_den > 0,\n",
    "                      np.sqrt(np.maximum(mu_eff * (1 - mu_eff), 0.0) /\n",
    "                              np.where(mu_den > 0, mu_den, 1)),\n",
    "                      np.nan)\n",
    "    cln_err = np.where(cln_den > 0,\n",
    "                       np.sqrt(np.maximum(cln_eff * (1 - cln_eff), 0.0) /\n",
    "                               np.where(cln_den > 0, cln_den, 1)),\n",
    "                       np.nan)\n",
    "    ratio = np.where(mu_eff > 0,\n",
    "                     cln_eff / np.where(mu_eff > 0, mu_eff, 1), np.nan)\n",
    "    rel = np.sqrt(np.where(cln_eff > 0,\n",
    "                           (cln_err / np.where(cln_eff > 0, cln_eff, 1)) ** 2, np.nan)\n",
    "                + np.where(mu_eff > 0,\n",
    "                           (mu_err / np.where(mu_eff > 0, mu_eff, 1)) ** 2, np.nan))\n",
    "    ratio_err = ratio * rel\n",
    "\n",
    "fig, axes = plt.subplots(2, 1, figsize=(FIGSIZE[0], FIGSIZE[1] * 1.4),\n",
    "                         sharex=True, gridspec_kw={\"height_ratios\": [2, 1]})\n",
    "half_w = 0.5 * (eff_pt_edges[1] - eff_pt_edges[0])\n",
    "\n",
    "# Top panel: efficiency overlays.\n",
    "ax = axes[0]\n",
    "valid = mu_den > 0\n",
    "ax.errorbar(eff_pt_centers[valid], mu_eff[valid],\n",
    "            xerr=half_w, yerr=mu_err[valid],\n",
    "            fmt=SPECIES_MARKER[\"Muon\"], color=SPECIES_COLOR[\"Muon\"],\n",
    "            markersize=3, capsize=CAPSIZE, capthick=1.2,\n",
    "            label=\"Muon (all GT)\")\n",
    "\n",
    "valid_c = cln_den > 0\n",
    "_vols = \"/\".join(f\"V{v}\" for v in _ce[\"filter_volumes\"])\n",
    "ax.errorbar(cln_pt_centers[valid_c], cln_eff[valid_c],\n",
    "            xerr=half_w, yerr=cln_err[valid_c],\n",
    "            fmt=\"o\", color=\"#8c564b\", markersize=3,\n",
    "            capsize=CAPSIZE, capthick=1.2,\n",
    "            label=f\"Muon (best fit: 0 misses in {_vols})\")\n",
    "\n",
    "overlay_dips(ax, label=\"staircase dip (muon-derived)\")\n",
    "for lay, thr in dip_layers:\n",
    "    ax.axvline(thr, color=\"grey\", linestyle=\":\", linewidth=1.0, alpha=0.5)\n",
    "\n",
    "ax.set_ylabel(\"Efficiency\", fontsize=FONT_AXIS)\n",
    "ax.set_title(f\"Muon efficiency vs $p_T$ — {_vols} clean filter\", fontsize=12)\n",
    "ax.tick_params(labelsize=FONT_TICK)\n",
    "ax.set_ylim(0.0, 1.05)\n",
    "ax.grid(True, alpha=GRID_ALPHA)\n",
    "ax.legend(fontsize=FONT_LEGEND, loc=\"lower right\")\n",
    "\n",
    "# Bottom panel: clean / original ratio.\n",
    "ax = axes[1]\n",
    "ax.errorbar(cln_pt_centers, ratio, xerr=half_w, yerr=ratio_err,\n",
    "            fmt=\"o\", color=\"black\", markersize=3,\n",
    "            capsize=CAPSIZE, capthick=1.2)\n",
    "ax.axhline(1.0, color=\"grey\", linestyle=\"--\", linewidth=1.0, alpha=0.7)\n",
    "overlay_dips(ax)\n",
    "for lay, thr in dip_layers:\n",
    "    ax.axvline(thr, color=\"grey\", linestyle=\":\", linewidth=1.0, alpha=0.5)\n",
    "\n",
    "ax.set_xlabel(r\"$p_T$ [GeV]\", fontsize=FONT_AXIS)\n",
    "ax.set_ylabel(r\"$\\epsilon_\\mathrm{clean}\\,/\\,\\epsilon_\\mathrm{all\\,GT}$\",\n",
    "              fontsize=FONT_AXIS - 4)\n",
    "ax.tick_params(labelsize=FONT_TICK)\n",
    "ax.set_xlim(eff_pt_edges[0], eff_pt_edges[-1])\n",
    "ax.grid(True, alpha=GRID_ALPHA)\n",
    "\n",
    "fig.tight_layout()\n",
    "out = ALL_GT_JSON.parent / \"eff_muon_clean_v13_v17_replot.pdf\"\n",
    "fig.savefig(out, bbox_inches=\"tight\", dpi=DPI)\n",
    "print(f\"Saved: {out}\")\n",
    "\n",
    "print(\"\")\n",
    "print(\"pT bin | d_orig | d_clean | eff_orig | eff_clean | ratio\")\n",
    "for i in range(len(cln_pt_centers)):\n",
    "    if mu_den[i] == 0:\n",
    "        continue\n",
    "    eo = mu_eff[i]\n",
    "    ec = cln_eff[i] if cln_den[i] > 0 else float(\"nan\")\n",
    "    r  = ratio[i]  if (cln_den[i] > 0 and mu_eff[i] > 0) else float(\"nan\")\n",
    "    print(f\"  {cln_pt_centers[i]:.3f}  {int(mu_den[i]):5d}   \"\n",
    "          f\"{int(cln_den[i]):5d}   {eo:.3f}    {ec:.3f}    {r:.3f}\")\n",
    "plt.show()\n"
   ]
  },
