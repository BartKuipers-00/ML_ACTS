    "pt_centers_local = 0.5 * (pt_edges_local[:-1] + pt_edges_local[1:])\n",
    "half_w           = 0.5 * (pt_edges_local[1] - pt_edges_local[0])\n",
    "\n",
    "\n",
    "def _hits_vs_pt(directory: Path, pdg_code: int):\n",
    "    with uproot.open(directory / \"particles_simulation.root\") as f:\n",
    "        arrs = f[\"particles\"].arrays([\"particle_type\", \"pt\", \"number_of_hits\"],\n",
