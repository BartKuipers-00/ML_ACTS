    "# ── Triplet seeding fake rate vs seed pT — clean, axis 0.0–0.55 ──────────\n",
    "# Loads seeding_fake_rate_per_pt.json (produced by\n",
    "# acts/output_examples/helpers/seeding_fake_rate_per_pt.C).\n",
    "#\n",
    "# A seed is \"matched\" iff some (event_nr, track_index) row in\n",
    "# performance_seeding.root's matchingdetails tree has matched=True\n",
    "# (majority truth particle >= matchingFractionThreshold of seed hits).\n",
    "# All other seeds are fake. Binned by per-seed track_pt.\n",
    "\n",
    "_SFR_JSON = DATA_DIR / \"seeding_fake_rate_per_pt.json\"\n",
    "with open(_SFR_JSON) as _f:\n",
    "    _sfr = json.load(_f)\n",
    "\n",
    "_sfr_centers = np.array(_sfr[\"pt_centers\"])\n",
    "_sfr_edges   = np.array(_sfr[\"pt_edges\"])\n",
    "\n",
    "tot = np.array(_sfr[\"n_total\"], dtype=float)\n",
    "fk  = np.array(_sfr[\"n_fake\"],  dtype=float)\n",
    "valid = tot > 0\n",
    "fr = np.where(valid, fk / np.where(valid, tot, 1), np.nan)\n",
    "\n",
    "fig, ax = plt.subplots(figsize=FIGSIZE)\n",
    "half_w = 0.5 * (_sfr_edges[1] - _sfr_edges[0])\n",
    "ax.errorbar(_sfr_centers[valid], fr[valid], xerr=half_w,\n",
    "            fmt=\"o\", color=\"black\",\n",
    "            markersize=3, capsize=CAPSIZE, capthick=1.2,\n",
    "            label=\"Triplet seeding\")\n",
    "\n",
    "ax.set_xlabel(r\"$p_T$ [GeV]\", fontsize=FONT_AXIS)\n",
    "ax.set_ylabel(\"Fake rate\", fontsize=FONT_AXIS)\n",
    "ax.tick_params(labelsize=FONT_TICK)\n",
    "ax.set_xlim(0.0, 0.55)\n",
    "ax.set_xticks(np.arange(0.1, 0.51, 0.1))\n",
    "ax.set_xticks(np.arange(0.05, 0.51, 0.1), minor=True)\n",
    "ax.set_ylim(0.0, 1.05)\n",
    "ax.grid(True, which=\"both\", alpha=GRID_ALPHA)\n",
    "ax.legend(fontsize=FONT_LEGEND, loc=\"upper left\")\n",
    "fig.tight_layout()\n",
    "\n",
    "out = DATA_DIR / \"seeding_fake_rate_vs_pt.pdf\"\n",
    "fig.savefig(out, bbox_inches=\"tight\", dpi=DPI)\n",
    "print(f\"Saved: {out}\")\n",
    "plt.show()\n"
   ]
