     "metadata": {},
     "output_type": "display_data"
    }
   ],
   "source": [
    "# ── Overall efficiency (all species, macro-avg): Triplet seeding vs Triplet + CKF ──\n",
    "# \"All species\" = unweighted mean of per-species efficiencies (each species\n",
    "# weighted equally, NOT by particle count). Avoids shifts driven by changes\n",
    "# in species composition across pT bins.\n",
    "\n",
    "fig, ax_p = plt.subplots(figsize=FIGSIZE)\n",
    "\n",
    "_all_species = [\"Electron\", \"Muon\", \"Pion\", \"Proton\"]\n",
    "\n",
    "def _macro_avg(data):\n",
    "    \"\"\"Return (eff_macro, lo_macro, hi_macro, mask) on the GNN grid.\"\"\"\n",
    "    eff_stack, lo_stack, hi_stack = [], [], []\n",
    "    for s in _all_species:\n",
    "        n, d = _rebin_to_gnn(np.array(data[\"num\"][s], float),\n",
    "                             np.array(data[\"den\"][s], float),\n",
    "                             acts_pt_centers_p1)\n",
    "        valid = d > 0\n",
    "        eff = np.where(valid, n / np.where(valid, d, 1), np.nan)\n",
    "        lo, hi = _kf_cp_err(n, d)\n",
    "        eff_stack.append(eff)\n",
    "        lo_stack.append(np.where(valid, lo, np.nan))\n",
    "        hi_stack.append(np.where(valid, hi, np.nan))\n",
    "    eff_stack = np.vstack(eff_stack)\n",
    "    lo_stack  = np.vstack(lo_stack)\n",
    "    hi_stack  = np.vstack(hi_stack)\n",
    "    with np.errstate(invalid=\"ignore\"):\n",
    "        eff_m = np.nanmean(eff_stack, axis=0)\n",
    "        n_val = np.sum(np.isfinite(eff_stack), axis=0)\n",
    "        lo_m  = np.sqrt(np.nansum(lo_stack**2, axis=0)) / np.where(n_val > 0, n_val, 1)\n",
    "        hi_m  = np.sqrt(np.nansum(hi_stack**2, axis=0)) / np.where(n_val > 0, n_val, 1)\n",
    "    mask = n_val == len(_all_species)\n",
    "    return eff_m, lo_m, hi_m, mask\n",
    "\n",
    "# Triplet seeding\n",
    "eff_m, lo_m, hi_m, mask = _macro_avg(seed_data)\n",
    "ax_p.errorbar(gnn_x[mask], eff_m[mask],\n",
    "              xerr=gnn_xerr[mask],\n",
    "              yerr=[lo_m[mask], hi_m[mask]],\n",
    "              fmt=METHOD_MARKER_P1[\"seed\"], color=\"#1f3a68\",\n",
    "              markersize=MS_P1, capsize=CAPSIZE, capthick=1,\n",
    "              label=\"Triplet seeding\")\n",
    "\n",
    "# Triplet seeding + CKF\n",
    "eff_m, lo_m, hi_m, mask = _macro_avg(eff_data)\n",
    "ax_p.errorbar(gnn_x[mask], eff_m[mask],\n",
    "              xerr=gnn_xerr[mask],\n",
    "              yerr=[lo_m[mask], hi_m[mask]],\n",
    "              fmt=METHOD_MARKER_P1[\"ckf\"], color=\"#c0392b\",\n",
    "              markersize=MS_P1, capsize=CAPSIZE, capthick=1,\n",
    "              label=\"Triplet seeding + CKF\")\n",
    "\n",
    "ax_p.set_xlabel(r\"$p_T$ [GeV]\", fontsize=FONT_AXIS)\n",
    "ax_p.set_ylabel(\"Efficiency\", fontsize=FONT_AXIS)\n",
    "ax_p.set_xlim(0.0, 0.55)\n",
    "ax_p.set_xticks(np.arange(0.1, 0.51, 0.1))\n",
    "ax_p.set_xticks(np.arange(0.05, 0.51, 0.1), minor=True)\n",
    "ax_p.set_ylim(0.0, 1.05)\n",
    "ax_p.tick_params(labelsize=FONT_TICK - 1)\n",
    "ax_p.grid(True, which=\"both\", alpha=GRID_ALPHA)\n",
    "ax_p.legend(fontsize=FONT_LEGEND - 1, loc=\"upper left\", frameon=False)\n",
    "\n",
    "ANNO_ANCHOR = (0.42, 0.24)\n",
    "_anno_box = dict(facecolor=\"white\", edgecolor=\"none\", alpha=0.85, pad=2)\n",
    "_ax, _ay = ANNO_ANCHOR\n",
    "_anno_kw = dict(transform=ax_p.transAxes, va=\"top\", ha=\"left\", bbox=_anno_box)\n",
    "ax_p.text(_ax, _ay,                       r\"$\\mathbf{Generic \\ Detector}$ Simulation\",\n",
    "          fontsize=FONT_AXIS - 3, **_anno_kw)\n",
    "ax_p.text(_ax, _ay -  ANNO_LINE_DY,    \"FATRAS, 300 particles / event\",\n",
    "          fontsize=FONT_AXIS - 5, style=\"italic\", **_anno_kw)\n",
    "ax_p.text(_ax, _ay - 2 * ANNO_LINE_DY,    r\"$|\\eta| < 0.15$, species-averaged\",\n",
    "          fontsize=FONT_AXIS - 5, style=\"italic\", **_anno_kw)\n",
    "\n",
    "fig.tight_layout()\n",
    "out = DATA_DIR / \"eff_seeding_ckf_overall_replot.pdf\"\n",
    "fig.savefig(out, bbox_inches=\"tight\", dpi=DPI)\n",
    "print(f\"Saved: {out}\")\n",
    "plt.show()\n"
   ]
  },
