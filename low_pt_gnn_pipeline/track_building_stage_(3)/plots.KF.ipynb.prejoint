    {
     "name": "stdout",
     "output_type": "stream",
     "text": [
      "\n",
      "Muon hits-per-particle summary:\n",
      "  Helix                                   : <hits> = 16.001  (N=75000)\n",
      "  Ablation                                : <hits> = 15.672  (N=74995)\n",
      "  global ratio new/old = 1.0210\n"
     ]
    }
   ],
   "source": [
    "# ── Mean hits per GT muon vs pT: new_build_1000 vs old_build1000-radial ───\n",
    "# Uses number_of_hits in particles_simulation.root. Top: <hits>(pT) overlaid\n",
    "# for both runs with std-error-of-mean error bars. Bottom: mean ratio new/old.\n",
    "\n",
    "import uproot\n",
    "import awkward as ak\n",
    "\n",
    "DIR_NUM = Path(\"/data/alice/bkuipers/acts/output_examples/single_points_data_run_new_build_1000\")\n",
    "DIR_DEN = Path(\"/data/alice/bkuipers/acts/output_examples/old_build1000-radial\")\n",
    "LABEL_NUM = \"Helix\"\n",
    "LABEL_DEN = \"Ablation\"\n",
    "\n",
    "SPECIES_PDG = 13   # 11=e, 13=mu, 211=pi, 2212=p\n",
    "SPECIES_TAG = {11: \"Electron\", 13: \"Muon\", 211: \"Pion\", 2212: \"Proton\"}[SPECIES_PDG]\n",
    "\n",
    "# pT binning — match eff_per_particle.json (40 bins, 0.1–0.5)\n",
    "PT_MIN, PT_MAX, N_BINS = 0.05, 0.5, 40\n",
    "pt_edges_local   = np.linspace(PT_MIN, PT_MAX, N_BINS + 1)\n",
    "pt_centers_local = 0.5 * (pt_edges_local[:-1] + pt_edges_local[1:])\n",
    "half_w           = 0.5 * (pt_edges_local[1] - pt_edges_local[0])\n",
    "\n",
    "\n",
    "def _hits_vs_pt(directory: Path, pdg_code: int):\n",
    "    with uproot.open(directory / \"particles_simulation.root\") as f:\n",
    "        arrs = f[\"particles\"].arrays([\"particle_type\", \"pt\", \"number_of_hits\"],\n",
    "                                     library=\"ak\")\n",
    "    pdg = np.abs(ak.to_numpy(ak.flatten(arrs[\"particle_type\"])))\n",
    "    pt  = ak.to_numpy(ak.flatten(arrs[\"pt\"]))\n",
    "    nh  = ak.to_numpy(ak.flatten(arrs[\"number_of_hits\"])).astype(float)\n",
    "\n",
    "    sel = (pdg == pdg_code) & (pt >= PT_MIN) & (pt < PT_MAX)\n",
    "    pt, nh = pt[sel], nh[sel]\n",
    "\n",
    "    bins = np.clip(np.searchsorted(pt_edges_local, pt, side=\"right\") - 1, 0, N_BINS - 1)\n",
    "    counts = np.bincount(bins, minlength=N_BINS).astype(float)\n",
    "    sums   = np.bincount(bins, weights=nh, minlength=N_BINS)\n",
    "    sums2  = np.bincount(bins, weights=nh * nh, minlength=N_BINS)\n",
    "    with np.errstate(divide=\"ignore\", invalid=\"ignore\"):\n",
    "        mean = np.where(counts > 0, sums / np.where(counts > 0, counts, 1), np.nan)\n",
    "        var  = np.where(counts > 1,\n",
    "                        (sums2 - counts * mean ** 2) / np.where(counts > 1, counts - 1, 1),\n",
    "                        np.nan)\n",
    "        sem  = np.where(counts > 0, np.sqrt(np.maximum(var, 0.0) / np.where(counts > 0, counts, 1)), np.nan)\n",
    "    return counts, mean, sem\n",
    "\n",
    "\n",
    "cnt_N, mean_N, sem_N = _hits_vs_pt(DIR_NUM, SPECIES_PDG)\n",
    "cnt_D, mean_D, sem_D = _hits_vs_pt(DIR_DEN, SPECIES_PDG)\n",
    "\n",
    "with np.errstate(divide=\"ignore\", invalid=\"ignore\"):\n",
    "    ratio = np.where(mean_D > 0, mean_N / np.where(mean_D > 0, mean_D, 1), np.nan)\n",
    "    rel_err = np.sqrt(np.where(mean_N > 0, (sem_N / np.where(mean_N > 0, mean_N, 1)) ** 2, np.nan)\n",
    "                    + np.where(mean_D > 0, (sem_D / np.where(mean_D > 0, mean_D, 1)) ** 2, np.nan))\n",
    "    ratio_err = ratio * rel_err\n",
    "\n",
    "\n",
    "fig, axes = plt.subplots(2, 1, figsize=(FIGSIZE[0], FIGSIZE[1] * 1.4),\n",
    "                         sharex=True, gridspec_kw={\"height_ratios\": [2, 1]})\n",
    "\n",
    "ax = axes[0]\n",
    "ax.errorbar(pt_centers_local, mean_N, xerr=half_w, yerr=sem_N,\n",
    "            fmt=\"o\", color=\"#1f77b4\", markersize=3,\n",
    "            capsize=CAPSIZE, capthick=1.2, label=LABEL_NUM)\n",
    "ax.errorbar(pt_centers_local, mean_D, xerr=half_w, yerr=sem_D,\n",
    "            fmt=\"s\", color=\"#d62728\", markersize=3,\n",
    "            capsize=CAPSIZE, capthick=1.2, label=LABEL_DEN)\n",
    "for lay, thr in dip_layers:\n",
    "    ax.axvline(thr, color=\"black\", linestyle=\"--\", linewidth=1.2, alpha=0.8)\n",
    "ax.set_ylabel(f\"Mean hits per Muon\", fontsize=FONT_AXIS)\n",
    "# ax.set_title(f\"Hits per GT {SPECIES_TAG} vs pT: {LABEL_NUM} vs {LABEL_DEN}\", fontsize=11)\n",
    "ax.tick_params(labelsize=FONT_TICK)\n",
    "ax.set_ylim(bottom=0)\n",
    "ax.grid(True, alpha=GRID_ALPHA)\n",
    "ax.legend(fontsize=FONT_LEGEND, loc=\"best\")\n",
    "\n",
    "ax = axes[1]\n",
    "ax.errorbar(pt_centers_local, ratio, xerr=half_w, yerr=ratio_err,\n",
    "            fmt=\"o\", color=\"black\", markersize=3,\n",
    "            capsize=CAPSIZE, capthick=1.2)\n",
    "ax.axhline(1.0, color=\"grey\", linestyle=\"--\", linewidth=1.0, alpha=0.7)\n",
    "for lay, thr in dip_layers:\n",
    "    ax.axvline(thr, color=\"black\", linestyle=\"--\", linewidth=1.2, alpha=0.8)\n",
    "ax.set_xlabel(r\"$p_T$ [GeV]\", fontsize=FONT_AXIS)\n",
    "ax.set_ylabel(r\"$\\langle N_{hit}\\rangle_\\mathrm{helix}\\,/\\,\\langle N_{hit}\\rangle_\\mathrm{Ablation}$\",\n",
    "              fontsize=FONT_AXIS - 4)\n",
    "ax.tick_params(labelsize=FONT_TICK)\n",
    "ax.set_xlim(pt_edges_local[0], pt_edges_local[-1])\n",
    "ax.grid(True, alpha=GRID_ALPHA)\n",
    "\n",
    "fig.tight_layout()\n",
    "out = DIR_NUM / f\"hits_per_{SPECIES_TAG.lower()}_vs_pt_ratio.pdf\"\n",
    "fig.savefig(out, bbox_inches=\"tight\", dpi=DPI)\n",
    "print(f\"Saved: {out}\")\n",
    "plt.show()\n",
    "\n",
    "# Summary\n",
    "print(f\"\\n{SPECIES_TAG} hits-per-particle summary:\")\n",
    "print(f\"  {LABEL_NUM:40s}: <hits> = {np.nansum(mean_N * cnt_N) / max(cnt_N.sum(), 1):.3f}  (N={int(cnt_N.sum())})\")\n",
    "print(f\"  {LABEL_DEN:40s}: <hits> = {np.nansum(mean_D * cnt_D) / max(cnt_D.sum(), 1):.3f}  (N={int(cnt_D.sum())})\")\n",
    "print(f\"  global ratio new/old = {np.nansum(mean_N * cnt_N) / max(np.nansum(mean_D * cnt_D), 1e-9):.4f}\")\n"
   ]
  },
