   "source": [
    "# ── Completeness vs pT (all species) — clean, axis 0.0–0.55 ──────────────────\n",
    "import json\n",
    "import numpy as np\n",
    "import matplotlib.pyplot as plt\n",
    "from pathlib import Path\n",
    "\n",
    "PLOT_DIR  = Path(\"/data/alice/bkuipers/low_pt_gnn_pipeline/data_300_mixed/visuals/track_metrics/testset_SegmentGNN\")\n",
    "COMP_JSON = PLOT_DIR / \"completeness_vs_pt_testset_SegmentGNN.json\"\n",
    "\n",
    "def _nan(lst):\n",
    "    return np.array([np.nan if v is None else v for v in lst], dtype=float)\n",
    "\n",
    "with open(COMP_JSON) as f:\n",
    "    comp_data = json.load(f)\n",
    "\n",
    "SPECIES_COLOR  = {\"Electron\": \"#2ca02c\", \"Muon\": \"#1f77b4\",\n",
    "                  \"Pion\": \"#ff7f0e\", \"Proton\": \"#d62728\"}\n",
    "SPECIES_MARKER = {\"Electron\": \"^\", \"Muon\": \"o\", \"Pion\": \"s\", \"Proton\": \"D\"}\n",
    "\n",
    "fig, ax = plt.subplots(figsize=FIGSIZE)\n",
    "for s in comp_data.get(\"series\", []):\n",
    "    label = re.sub(r\"\\s*\\(.*?\\)\\s*$\", \"\", s.get(\"label\", \"\"))\n",
    "    x       = _nan(s[\"x\"])\n",
    "    xerr    = _nan(s[\"xerr\"])\n",
    "    y       = _nan(s[\"y\"])\n",
    "    yerr_lo = _nan(s[\"yerr_lo\"])\n",
    "    yerr_hi = _nan(s[\"yerr_hi\"])\n",
    "    ax.errorbar(\n",
    "        x, y, xerr=xerr, yerr=[yerr_lo, yerr_hi],\n",
    "        fmt=SPECIES_MARKER.get(label, s.get(\"marker\", \"o\")),\n",
    "        color=SPECIES_COLOR.get(label, s.get(\"color\", None)),\n",
    "        markersize=3, capsize=CAPSIZE, capthick=1.2, label=label,\n",
    "    )\n",
    "\n",
    "ax.set_xlabel(r\"$p_T$ [GeV]\", fontsize=FONT_AXIS)\n",
    "ax.set_ylabel(\"Completeness (fraction of true hits found)\", fontsize=FONT_AXIS)\n",
    "ax.tick_params(labelsize=FONT_TICK)\n",
    "ax.set_xlim(0.0, 0.55)\n",
    "ax.set_xticks(np.arange(0.1, 0.51, 0.1))\n",
    "ax.set_xticks(np.arange(0.05, 0.51, 0.1), minor=True)\n",
    "ax.set_ylim(0.0, 1.05)\n",
    "ax.grid(True, which=\"both\", alpha=GRID_ALPHA)\n",
    "ax.legend(fontsize=FONT_LEGEND, loc=\"lower left\")\n",
    "fig.tight_layout()\n",
    "\n",
    "out = COMP_JSON.parent / \"completeness_clean_replot.pdf\"\n",
    "fig.savefig(out, bbox_inches=\"tight\", dpi=DPI)\n",
    "print(f\"Saved: {out}\")\n",
    "plt.show()\n"
   ]
  },
